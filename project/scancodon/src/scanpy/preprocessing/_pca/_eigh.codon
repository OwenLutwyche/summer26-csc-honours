# eigendecomposition module, replacement for scanpy.pp.pca's _dask.py
# renamed since it's an eigendecomposition module

import numpy as np
from numpy import ndarray
from typing import Tuple

from ..._csr import CSRMatrix
from ._kernels import csr_gram_dense

def cov_sparse(X: CSRMatrix) -> Tuple[ndarray[float, 2], ndarray[float, 1]]:
    """
    Compute the covariance matrix and column means of sparse matrix X.
    Mirrors the logic of _cov_sparse_dask in Scanpy.
    
    Parameters
    ----------
    X : CSRMatrix
        Input sparse matrix.
        
    Returns
    -------
    cov_result : ndarray[float, 2]
        Dense covariance matrix.
    mean_x : ndarray[float, 1]
        Column means of the original matrix.
    """
    n_obs = X.shape[0]
    n_vars = X.shape[1]

    # 1. Compute the Gram matrix (X.T @ X) natively from CSR
    gram_matrix = csr_gram_dense(X)
    
    # 2. Compute the column means natively
    mean_x = X.mean0()
    
    # 3. Divide by N (Scanpy divides Gram by N before subtracting means)
    gram_matrix /= float(n_obs)
    
    # 4. Subtract the outer product of means to get the covariance matrix
    # cov(X, X) = E(XX) - E(X)E(X)
    cov_result = np.zeros((n_vars, n_vars), dtype=float)
    for i in range(n_vars):
        for j in range(n_vars):
            cov_result[i, j] = gram_matrix[i, j] - (mean_x[i] * mean_x[j])
            
    return cov_result, mean_x