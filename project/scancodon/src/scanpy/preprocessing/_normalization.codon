# Pure Codon kernel for scanpy.preprocessing._normalization
# This function accepts numpy arrays only - no AnnData objects

import numpy as np
from numpy import ndarray
from typing import Optional, Tuple
from .._csr import CSRMatrix 


def _ensure_dense(x):
    """Convert sparse matrix to dense if needed."""
    if hasattr(x, "toarray"):
        return x.toarray()
    return x    

def normalize_total_sparse_kernel(
    x: CSRMatrix, 
    target_sum: float
    ) -> Tuple[CSRMatrix, ndarray[float, 1]]:
    '''
    normalize counts per cell. in-place, sparse CSR
    scales x.data in place using CSRMatrix.scale_rows_inplace

    Returns
    -------
    x : CSRMatrix
        Normalized matrix (modified in-place)
    norm_factor : ndarray[float, 1]
        Normalization factors per cell
    '''
    n_rows: int = x.shape[0]
    
    counts = x.sum1()
    
    scales = np.zeros(n_rows, dtype=float)
    norm_factor = np.zeros(n_rows, dtype=float)
    
    for i in range(n_rows):
        c = counts[i]
        scales[i] = target_sum / (c if c > 1e-12 else 1e-12)
        norm_factor[i] = c / target_sum
        
    x.scale_rows_inplace(scales)
    
    return x, norm_factor


def normalize_total_dense_kernel(
    x,
    target_sum: Optional[float] = None,
    exclude_highly_expressed: bool = False,
    max_fraction: float = 0.05,
):
    """Normalize counts per cell.
    
    Parameters
    ----------
    x : np.ndarray
        Expression matrix (cells x genes), modified in-place
    target_sum : Optional[float]
        Target sum for normalization (default: median of total counts)
    exclude_highly_expressed : bool
        Exclude genes with high fraction of counts
    max_fraction : float
        Maximum fraction of counts for a gene to be included
    
    Returns
    -------
    x : np.ndarray
        Normalized matrix (same object, modified in-place)
    norm_factor : np.ndarray
        Normalization factors per cell
    """
    x = _ensure_dense(x)
    
    if not "float64" in str(x.dtype):
        x = x.astype("float64")
    
    counts_per_cell: ndarray[float, 1] = x.sum(axis=1)
    
    # Optionally exclude highly expressed genes
    if exclude_highly_expressed:
        n_genes: int = int(x.shape[1])
        gene_mask: ndarray[bool, 1] = np.ones(n_genes, dtype=bool)
        
        for g in range(n_genes):
            gene_counts: ndarray[float, 1] = x[:, g]
            fractions: ndarray[float, 1] = gene_counts / np.maximum(counts_per_cell, 1e-12)
            if np.any(fractions > max_fraction):
                # Boolean mask __setitem__ can fail in native Codon — use np.where.
                idx: ndarray[bool, 1] = np.arange(n_genes) == g
                gene_mask = np.where(idx, False, gene_mask)
        
        # Recompute counts with gene subset
        counts_per_cell = x[:, gene_mask].sum(axis=1)
    
    # Determine target sum
    if target_sum is None:
        nonzero: ndarray[float, 1] = counts_per_cell[counts_per_cell > 0]
        if len(nonzero) > 0:
            target_sum = float(np.median(nonzero))
        else:
            target_sum = 1.0
        
    # type narrowing doesn't work on if-else
    ts: float = float(target_sum)
    # Normalize
    scale_factors: ndarray[float, 1] = ts / np.maximum(counts_per_cell, 1e-12)
    x *= scale_factors.reshape(int(scale_factors.shape[0]), 1)
    
    norm_factor: ndarray[float, 1] = counts_per_cell / ts
    
    return x, norm_factor