# Codon port of scanpy.preprocessing._highly_variable_genes

import numpy as np
from numpy import ndarray
from typing import Optional, Tuple, List
import math
from .._csr import CSRMatrix

_FLOAT64_MAX = 1.7976931348623157e+308

def _nan_to_num(arr: ndarray[float, 1], nan_val: float) -> ndarray[float, 1]:
    """
    Replaces NaNs and Infs in-place. 
    NaNs replaced with nan_val
    Infs replaced with _FLOAT64_MAX
    """
    for i in range(arr.shape[0]):
        v = arr[i]
        if math.isnan(v):
            arr[i] = nan_val
        elif math.isinf(v):
            # Replace inf with the maximum/minimum representable 64-bit float
            arr[i] = _FLOAT64_MAX if v > 0.0 else -_FLOAT64_MAX
    return arr

def _num_to_nan(arr: ndarray[float, 1], num_val: float) ->ndarray[float, 1]:
    """
    Replaces numbers that equal num_val with NaNs
    """
    for i in range(arr.shape[0]):
        v=arr[i]
        if v == num_val:
            arr[i] = math.nan
    return arr

def _mean_var(x: ndarray[float, 2]) -> Tuple[ndarray[float, 1], ndarray[float, 1]]:
    """Compute per-gene mean and unbiased variance (ddof=1)."""
    means = x.mean(axis=0)
    vars_ = x.var(axis=0, ddof=1)
    return means, vars_

def _assign_bins(values: list[float], n_bins: int) -> list[int]:
    """Assign each value to one of n_bins equally sized intervals over its range.
    If all values identical, everyone gets bin 0.
    """
    if len(values) == 0:
        return []
    vmin = min(values)
    vmax = max(values)
    if vmax == vmin:
        return [0] * len(values)
    width = (vmax - vmin) / n_bins
    bins: list[int] = []
    for v in values:
        b = int((v - vmin) / width)
        if b == n_bins:  # edge case at upper bound
            b -= 1
        bins.append(b)
    return bins


def highly_variable_genes_seurat_dense(
    x_log: ndarray[float, 2],
    n_top_genes: Optional[int],
    min_mean: float = 0.0125,
    max_mean: float = 3.0,
    n_bins: int = 20,
    check_values: bool = True, # ignored; kept for signature similarity, TODO: add functionality
) -> Tuple[ndarray[bool, 1], ndarray[float, 1], ndarray[float, 1], ndarray[float, 1], ndarray[float, 1]]:
    """Dense implementation of Seurat-style dispersion HVG selection.

    Returns: hv_mask, means, variances, dispersions, dispersions_norm
    """
    if n_top_genes is not None:
        # If tracking top genes, Scanpy ignores these thresholds globally
        min_mean = -_FLOAT64_MAX
        max_mean = _FLOAT64_MAX
    # unlog the input, otherwise we'll be doing all our operations in the wrong domain
    # this is how scanpy works too - just assume input data is logarithmized
    x = np.expm1(x_log)

    means_arr, vars_arr = _mean_var(x)
    n_genes = x.shape[1]

    dispersions = vars_arr / means_arr

    # set dispersions to NaN where 0
    dispersions = _num_to_nan(dispersions, 0.0)

    log_means = np.log1p(means_arr)
    log_disp = np.log(dispersions)

    # Filter genes by mean range
    use_mask: list[int] = []
    for idx in range(n_genes):
        m_val: float = float(log_means[idx])
        if m_val > min_mean and m_val < max_mean:
            use_mask.append(1)
        else:
            use_mask.append(0)

    # Collect values for binning
    log_means_list: list[float] = []
    log_disp_list: list[float] = []
    gene_indices: list[int] = []
    for g in range(n_genes):
        if use_mask[g] == 1:
            log_means_list.append(float(log_means[g]))
            log_disp_list.append(float(log_disp[g]))
            gene_indices.append(g)

    # Bin and compute mean/std per bin
    bins = _assign_bins(log_means_list, n_bins) if len(log_means_list) > 0 else []
    bin_sum: list[float] = [0.0] * n_bins
    bin_sum_sq: list[float] = [0.0] * n_bins
    bin_count: list[int] = [0] * n_bins
    for i, b in enumerate(bins):
        val = log_disp_list[i]
        bin_sum[b] += val
        bin_sum_sq[b] += val * val
        bin_count[b] += 1
    bin_mean: list[float] = [0.0] * n_bins
    bin_std: list[float] = [1.0] * n_bins
    for b in range(n_bins):
        if bin_count[b] > 0:
            m = bin_sum[b] / bin_count[b]
            if bin_count[b] == 1:
                bin_std[b] = m
                bin_mean[b] = 0.0
            else:
                var = (bin_sum_sq[b] - bin_sum[b] * bin_sum[b] / bin_count[b]) / (bin_count[b] - 1)
                if var < 0.0:
                    var = 0.0
                sd = np.sqrt(var)
                if sd <= 0.0:
                    sd = 1.0
                bin_mean[b] = m
                bin_std[b] = sd

    dispersions_norm: list[float] = [0.0] * n_genes
    for local_i, gene_index in enumerate(gene_indices):
        b = bins[local_i]
        dn = (log_disp_list[local_i] - bin_mean[b]) / bin_std[b]
        dispersions_norm[gene_index] = dn

    # zero-dispersion genes become NaN so log(dispersion) stays NaN rather than -inf
    dispersions_norm = _nan_to_num(np.asarray(dispersions_norm), 0.0)
    # Rank only within the filtered genes, not all n_genes
    # sorting should handle boundaries differently: we want to use >= so that ties at the cutoff are included
    # find nth highest dispersions_norm value among all filtered genes (exlude nans), then everything equal and above are highly variable
    valid_disp: list[float] = []
    for g in gene_indices:
        valid_disp.append(float(dispersions_norm[g]))
        
    valid_disp.sort(reverse=True)
    
    if n_top_genes > len(valid_disp):
        n_top_genes = len(valid_disp)
        
    hv_mask: ndarray[bool, 1] = np.zeros(n_genes, dtype=np.bool_)
    
    if n_top_genes > 0:
        disp_cut_off = valid_disp[n_top_genes - 1]
        for g in gene_indices:
            if float(dispersions_norm[g]) >= disp_cut_off:
                hv_mask[g] = True
    
    return hv_mask, log_means, vars_arr, log_disp, dispersions_norm


def highly_variable_genes_cell_ranger_dense(
    x: ndarray[float, 2],
    n_top_genes: int = 2000,
    min_mean: float = 0.0125,
    max_mean: float = 3.0,
    n_bins: int = 20,
    check_values: bool = True, # ignored; kept for signature similarity. TODO: add functionality
) -> Tuple[ndarray[bool, 1], ndarray[float, 1], ndarray[float, 1], ndarray[float, 1], List[float]]:
    """Dense implementation of Cell Ranger-style HVG selection.

    Normalization uses per-bin median and MAD of raw dispersion.
    Returns: hv_mask, means, variances, dispersions, dispersions_norm
    """
    means_arr, vars_arr = _mean_var(x)
    n_genes = x.shape[1]
    dispersions = vars_arr / (means_arr + 1e-12)
    log_means = np.log1p(means_arr)

    use_mask: list[int] = []
    for idx in range(n_genes):
        m_val: float = float(means_arr[idx])
        if m_val > min_mean and m_val < max_mean:
            use_mask.append(1)
        else:
            use_mask.append(0)

    log_means_list: list[float] = []
    disp_list: list[float] = []
    gene_indices: list[int] = []
    for g in range(n_genes):
        if use_mask[g] == 1:
            log_means_list.append(float(log_means[g]))
            disp_list.append(float(dispersions[g]))
            gene_indices.append(g)
    bins = _assign_bins(log_means_list, n_bins) if len(log_means_list) > 0 else []
    # Collect dispersion values per bin
    bin_vals: list[list[float]] = [[] for _ in range(n_bins)]
    for i, b in enumerate(bins):
        bin_vals[b].append(disp_list[i])
    bin_median: list[float] = [0.0] * n_bins
    bin_mad: list[float] = [1.0] * n_bins
    for b in range(n_bins):
        vals = bin_vals[b]
        if len(vals) == 0:
            continue
        sorted_vals = sorted(vals)
        mid = len(sorted_vals) // 2
        if len(sorted_vals) % 2 == 1:
            med = sorted_vals[mid]
        else:
            med = 0.5 * (sorted_vals[mid - 1] + sorted_vals[mid])
        # MAD
        deviations: list[float] = []
        for v in sorted_vals:
            deviations.append(abs(v - med))
        deviations.sort()
        mid2 = len(deviations) // 2
        if len(deviations) % 2 == 1:
            mad = deviations[mid2]
        else:
            mad = 0.5 * (deviations[mid2 - 1] + deviations[mid2])
        if mad <= 0.0:
            mad = 1.0
        bin_median[b] = med
        bin_mad[b] = mad
    dispersions_norm: list[float] = [0.0] * n_genes
    for local_i, gene_index in enumerate(gene_indices):
        b = bins[local_i]
        dn = (disp_list[local_i] - bin_median[b]) / bin_mad[b]
        dispersions_norm[gene_index] = dn
    ranked = sorted(range(n_genes), key=lambda g: dispersions_norm[g], reverse=True)
    if n_top_genes > n_genes:
        n_top_genes = n_genes
    hv_mask: ndarray[bool, 1] = np.zeros(n_genes, dtype=np.bool_)
    for idx in ranked[:n_top_genes]:
        hv_mask[idx] = True
    return hv_mask, means_arr, vars_arr, dispersions, dispersions_norm


def _smooth_var(log_mean: list[float], log_var: list[float], window: int) -> list[float]:
    '''
    moving-average smoother
    approximates a loess fit of log_var on log_mean
    replacement for seurat_v3's actual loess regression
    PRECONDITION: inputs must already by sorted by log_mean. window is positional.
    '''
    n = len(log_mean)
    fitted: list[float] = [0.0] * n
    half = window // 2
    for i in range(n):
        start = 0 if i - half < 0 else i - half
        end = n if i + half + 1 > n else i + half + 1
        # simple average of log_var in window
        s: float = 0.0
        count: int = 0
        for j in range(start, end):
            s += log_var[j]
            count += 1
        fitted[i] = s / count if count > 0 else 0.0
    return fitted


def highly_variable_genes_seurat_v3_dense(
    x: ndarray[float, 2],  # numpy array (cells x genes) raw counts
    n_top_genes: int = 2000,
    span: float = 0.3,  # this and #check_values are ignored; kept for signature similarity
    check_values: bool = True, # TODO add functionality
) -> Tuple[ndarray[bool, 1], ndarray[float, 1], ndarray[float, 1], List[float]]:
    """Simplified dense HVG selection inspired by seurat_v3.

    Steps:
    1. Compute mean and variance per gene.
    2. Work on non-constant genes (variance > 0).
    3. Fit a crude smoother (moving average) on log10(mean) vs log10(var).
    4. Regularized std = sqrt(10 ** fitted_log_var)
    5. Clip counts effect approximation: we skip as we lack raw cell-wise loops for performance.
    6. Normalized gene variance: (var) / (reg_std^2)
    7. Rank by normalized variance and select top n_top_genes.

    Returns:
    highly_variable_mask, means, variances, normalized_variances
    """
    n_cells = x.shape[0]
    n_genes = x.shape[1]

    means_arr = x.mean(axis=0)
    vars_arr = x.var(axis=0, ddof=1)

    # Non-constant mask
    not_const_mask: list[bool] = []
    for v in vars_arr:
        not_const_mask.append(v > 0.0)

    log_mean: list[float] = []
    log_var: list[float] = []
    indices: list[int] = []
    for g in range(n_genes):
        if not_const_mask[g]:
            # avoid log of zero
            m = means_arr[g]
            v = vars_arr[g]
            if m <= 0.0:
                m = 1e-12
            if v <= 0.0:
                v = 1e-12
            log_mean.append(np.log10(m))
            log_var.append(np.log10(v))
            indices.append(g)

    if len(log_mean) == 0:
        # all zero variance genes; return all False
        hv_arr: ndarray[bool, 1] = np.zeros(n_genes, dtype=np.bool_)
        return hv_arr, means_arr, vars_arr, [0.0] * n_genes

    # Sort by log_mean for smoothing
    order = sorted(range(len(log_mean)), key=lambda i: log_mean[i])
    sorted_log_mean = [log_mean[i] for i in order]
    sorted_log_var = [log_var[i] for i in order]

    # window size heuristic: max(5, int(0.1 * len))
    window = 5
    cand = int(0.1 * len(sorted_log_mean))
    if cand > window:
        window = cand
    if window % 2 == 0:
        window += 1

    fitted_sorted = _smooth_var(sorted_log_mean, sorted_log_var, window)

    # Map back to original indices
    fitted_log_var: list[float] = [0.0] * len(order)
    for rank, pos in enumerate(order):
        fitted_log_var[pos] = fitted_sorted[rank]

    # Regularized std
    reg_std: list[float] = []
    for flv in fitted_log_var:
        reg_std.append(np.sqrt(10 ** flv))

    # Normalized variance approximation: var / reg_std^2
    norm_var: list[float] = [0.0] * n_genes
    for local_i, gene_index in enumerate(indices):
        denom = reg_std[local_i] * reg_std[local_i]
        if denom <= 0.0:
            denom = 1.0
        norm = vars_arr[gene_index] / denom
        norm_var[gene_index] = norm

    # Rank genes by normalized variance
    ranked = sorted(range(n_genes), key=lambda g: norm_var[g], reverse=True)
    if n_top_genes > n_genes:
        n_top_genes = n_genes
    hv_set = set(ranked[:n_top_genes])

    hv_arr: ndarray[bool, 1] = np.zeros(n_genes, dtype=np.bool_)
    for g in range(n_genes):
        if g in hv_set:
            hv_arr[g] = True

    return hv_arr, means_arr, vars_arr, norm_var

def highly_variable_genes_seurat_sparse(
    x_log: CSRMatrix,
    n_top_genes: int = 2000,
    min_mean: float = 0.0125,
    max_mean: float = 3.0,
    n_bins: int = 20,
    check_values: bool = True, # ignored; kept for signature similarity. TODO: add functionality
) -> Tuple[ndarray[bool, 1], ndarray[float, 1], ndarray[float, 1], ndarray[float, 1], ndarray[float, 1]]:
    """Sparse implementation of Seurat-style dispersion HVG selection.

    Operates natively on CSRMatrix structures via a single-pass accumulator.
    Returns: hv_mask, means, variances, dispersions, dispersions_norm
    """
    if n_top_genes > 0:
        # If tracking top genes, Scanpy ignores these thresholds globally
        min_mean = -_FLOAT64_MAX
        max_mean = _FLOAT64_MAX

    n_obs = x_log.shape[0]
    n_genes = x_log.shape[1]

    sums = np.zeros(n_genes, dtype=float)
    sum_sqs = np.zeros(n_genes, dtype=float)

    # 1. Single-pass sparse mean and variance accumulation
    for i in range(len(x_log.data)):
        col = x_log.indices[i]
        # Unlog the value. Sparsity is preserved because expm1(0) == 0
        val = math.expm1(x_log.data[i])
        sums[col] += val
        sum_sqs[col] += val * val

    means_arr = np.zeros(n_genes, dtype=float)
    vars_arr = np.zeros(n_genes, dtype=float)

    denom = float(n_obs - 1) if n_obs > 1 else 1.0
    
    for j in range(n_genes):
        m = sums[j] / float(n_obs)
        means_arr[j] = m
        
        # Variance with ddof=1 (sample variance)
        v = (sum_sqs[j] - (sums[j] * sums[j]) / float(n_obs)) / denom
        if v < 0.0:
            v = 0.0
        vars_arr[j] = v

    # 2. Dispersion calculation 
    dispersions = vars_arr / means_arr
    dispersions = _num_to_nan(dispersions, 0.0)

    log_means = np.log1p(means_arr)
    log_disp = np.log(dispersions)

    # 3. Filter genes by mean range
    use_mask: list[int] = []
    for idx in range(n_genes):
        m_val: float = float(log_means[idx])
        if m_val > min_mean and m_val < max_mean:
            use_mask.append(1)
        else:
            use_mask.append(0)

    # 4. Collect values for binning
    log_means_list: list[float] = []
    log_disp_list: list[float] = []
    gene_indices: list[int] = []
    for g in range(n_genes):
        if use_mask[g] == 1:
            log_means_list.append(float(log_means[g]))
            log_disp_list.append(float(log_disp[g]))
            gene_indices.append(g)

    # 5. Bin and compute mean/std per bin
    bins = _assign_bins(log_means_list, n_bins) if len(log_means_list) > 0 else []
    bin_sum: list[float] = [0.0] * n_bins
    bin_sum_sq: list[float] = [0.0] * n_bins
    bin_count: list[int] = [0] * n_bins
    
    for i, b in enumerate(bins):
        val = log_disp_list[i]
        bin_sum[b] += val
        bin_sum_sq[b] += val * val
        bin_count[b] += 1
        
    bin_mean: list[float] = [0.0] * n_bins
    bin_std: list[float] = [1.0] * n_bins
    for b in range(n_bins):
        if bin_count[b] > 0:
            m = bin_sum[b] / bin_count[b]
            if bin_count[b] == 1:
                bin_std[b] = m
                bin_mean[b] = 0.0
            else:
                var = (bin_sum_sq[b] - bin_sum[b] * bin_sum[b] / bin_count[b]) / (bin_count[b] - 1)
                if var < 0.0:
                    var = 0.0
                sd = np.sqrt(var)
                if sd <= 0.0:
                    sd = 1.0
                bin_mean[b] = m
                bin_std[b] = sd

    # 6. Normalize dispersions
    dispersions_norm: list[float] = [0.0] * n_genes
    for local_i, gene_index in enumerate(gene_indices):
        b = bins[local_i]
        dn = (log_disp_list[local_i] - bin_mean[b]) / bin_std[b]
        dispersions_norm[gene_index] = dn

    # NaNs must be resolved to 0 before sorting below
    dispersions_norm = _nan_to_num(np.asarray(dispersions_norm), 0.0)
    
    # 7. Rank and mask highly variable genes
    valid_disp: list[float] = []
    for g in gene_indices:
        valid_disp.append(float(dispersions_norm[g]))
        
    valid_disp.sort(reverse=True)
    
    if n_top_genes > len(valid_disp):
        n_top_genes = len(valid_disp)
        
    hv_mask: ndarray[bool, 1] = np.zeros(n_genes, dtype=np.bool_)
    
    if n_top_genes > 0:
        disp_cut_off = valid_disp[n_top_genes - 1]
        for g in gene_indices:
            if float(dispersions_norm[g]) >= disp_cut_off:
                hv_mask[g] = True
    
    return hv_mask, log_means, vars_arr, log_disp, dispersions_norm