import numpy as np
from numpy import ndarray
from typing import Tuple

from .core import Scrublet
from ..._csr import CSRMatrix 

def scrublet(
    data: ndarray[float, 1],
    indices: ndarray[int, 1],
    indptr: ndarray[int, 1],
    n_rows: int,
    n_cols: int,
    sim_doublet_ratio: float,
    expected_doublet_rate: float,
    stdev_doublet_rate: float,
    random_state: int
) -> ndarray[float, 1]:
    """
    Native Codon dispatcher for Scrublet.
    Reconstructs the CSRMatrix natively and initializes the pipeline.
    """
    print("scrublet: create CSRMatrix")
    # 1. Reconstruct the sparse matrix entirely in Codon memory
    matrix = CSRMatrix(data, indices, indptr, (n_rows, n_cols))
    
    print("scrublet: initialize Scrublet instance")
    # 2. Instantiate Scrublet class
    scrub = Scrublet(
        counts_obs=matrix,
        total_counts_obs=None,
        sim_doublet_ratio=sim_doublet_ratio,
        n_neighbors=-1,
        expected_doublet_rate=expected_doublet_rate,
        stdev_doublet_rate=stdev_doublet_rate,
        random_state=random_state
    )
    
    # [TODO] pipeline.normalize(), pipeline.pca(), etc.
    
    print("scrublet: run simulate_doublets()")
    # Run the native simulation (forcing subsampling to 1.0 for V1 performance)
    scrub.simulate_doublets(
        sim_doublet_ratio=sim_doublet_ratio,
        synthetic_doublet_umi_subsampling=1.0
    )
    
    print("scrublet: return data")
    sim_mat = scrub._counts_sim
    
    # return ( # this doesn't work yet
    #     sim_mat.data,
    #     sim_mat.indices,
    #     sim_mat.indptr,
    #     sim_mat.shape[0],
    #     sim_mat.shape[1],
    #     scrub._total_counts_sim,
    #     scrub.doublet_parents_
    # )
    # 3. return an array of zeros just for testing
    empty = np.zeros(n_rows, dtype=float)
    return empty    