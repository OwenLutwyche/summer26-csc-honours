import numpy as np
from numpy import ndarray
from typing import Tuple, Optional

from .core import Scrublet
from ..._csr import CSRMatrix 

def scrublet(
    data: ndarray[float, 1],
    indices: ndarray[int, 1],
    indptr: ndarray[int, 1],
    n_rows: int,
    n_cols: int,
    sim_doublet_ratio: float,
    expected_doublet_rate: float,
    stdev_doublet_rate: float,
    random_state: int
) -> Tuple[Optional[ndarray[float, 1]], ndarray[bool, 1]]:
    """
    Native Codon dispatcher for Scrublet.
    Executes the entire end-to-end doublet simulation and scoring pipeline.
    """
    matrix = CSRMatrix(data, indices, indptr, (n_rows, n_cols))
    
    scrub = Scrublet(
        counts_obs=matrix,
        total_counts_obs=None,
        sim_doublet_ratio=sim_doublet_ratio,
        n_neighbors=-1,
        expected_doublet_rate=expected_doublet_rate,
        stdev_doublet_rate=stdev_doublet_rate,
        random_state=random_state
    )
    
    # 1. Data Augmentation
    scrub.simulate_doublets(
        sim_doublet_ratio=sim_doublet_ratio,
        synthetic_doublet_umi_subsampling=1.0
    )
    
    # 2. Preprocessing
    scrub.pipeline_normalize()
    _gene_mean, _gene_std = scrub.pipeline_zscore()
    manifold_obs, manifold_sim = scrub.pipeline_pca(n_pcs=30)
    
    # 3. K-Nearest Neighbors Scoring
    scrub.calculate_doublet_scores(manifold_obs, manifold_sim, scrub.n_neighbors)
    scrub.calculate_doublet_errors()
    
    # 4. Thresholding
    predicted_doublets = scrub.call_doublets(threshold=-1.0)
    return scrub.doublet_scores_obs_, predicted_doublets