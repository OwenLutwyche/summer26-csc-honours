import numpy as np
from numpy import ndarray
from typing import Tuple, Optional

from .core import Scrublet
from ..._csr import CSRMatrix 

def scrublet(
    matrix: CSRMatrix,
    sim_doublet_ratio: float,
    expected_doublet_rate: float,
    stdev_doublet_rate: float,
    random_state: int
) -> Tuple[Optional[ndarray[float, 1]], ndarray[bool, 1]]:
    """
    Native Codon backend for the Scrublet doublet detection algorithm.
    
    Predict cell doublets in single-cell RNA-sequencing data 
    By simulating synthetic doublets and then scoring cells based on their KNN proximity to these simulated doublets.

    Parameters
    ----------
    matrix : CSRMatrix
        Sparse matrix of observed cell transcript counts.
    sim_doublet_ratio : float
        Ratio of synthetic doublets to simulate relative to the total number of observed cells.
    expected_doublet_rate : float
        Estimated fraction of observed cells that are doublets
    stdev_doublet_rate : float
        Standard deviation of the expected doublet rate.
    random_state : int
        Seed for the random number generator to ensure reproducible doublet simulations and PCA initializations.
        
    Returns
    -------
    doublet_scores : Optional[ndarray[float, 1]]
        1D array containing the computed doublet score for each observed cell.
    predicted_doublets : ndarray[bool, 1]
        1D boolean array indicating whether each corresponding cell is predicted to be a doublet based on an automatically calculated threshold.
    """
    scrub = Scrublet(
        counts_obs=matrix,
        total_counts_obs=None,
        sim_doublet_ratio=sim_doublet_ratio,
        n_neighbors=-1,
        expected_doublet_rate=expected_doublet_rate,
        stdev_doublet_rate=stdev_doublet_rate,
        random_state=random_state
    )
    
    # 1. Data Augmentation
    scrub.simulate_doublets(
        sim_doublet_ratio=sim_doublet_ratio,
        synthetic_doublet_umi_subsampling=1.0
    )
    
    # 2. Preprocessing
    scrub.pipeline_normalize()
    _gene_mean, _gene_std = scrub.pipeline_zscore()
    manifold_obs, manifold_sim = scrub.pipeline_pca(n_pcs=30)
    
    # 3. K-Nearest Neighbors Scoring
    scrub.calculate_doublet_scores(manifold_obs, manifold_sim, scrub.n_neighbors)
    scrub.calculate_doublet_errors()
    
    # 4. Thresholding
    predicted_doublets = scrub.call_doublets(threshold=-1.0)
    return scrub.doublet_scores_obs_, predicted_doublets