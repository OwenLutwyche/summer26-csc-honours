# Pure Codon kernels for scanpy.preprocessing._simple
# These functions accept numpy arrays only - no AnnData objects

import numpy as np
from numpy import ndarray
from typing import Optional, Tuple
import math


def filter_cells_dense_kernel(
    x: ndarray[float, 2],
    min_counts: Optional[int] = None,
    min_genes: Optional[int] = None,
    max_counts: Optional[int] = None,
    max_genes: Optional[int] = None,
) -> Tuple[ndarray[bool, 1], ndarray[float, 1]]:
    """
    Filter cell outliers based on counts and numbers of genes expressed.
    Dense kernel for dense array input
    Parameters
    ----------
    x : ndarray[float, 2]
        Expression matrix (cells x genes)
    min_counts, min_genes, max_counts, max_genes : Optional[int]
        Filtering thresholds (provide exactly one)
    
    Returns
    -------
    cell_subset : ndarray[bool, 1]
        Boolean mask of cells passing filter
    number_per_cell : ndarray[float, 1]
        Counts or genes per cell
    """
    # Compute counts or genes per cell
    if min_genes is not None or max_genes is not None:
        number_per_cell = np.sum(x > 0.0, axis=1).astype(np.float64)
    else:
        number_per_cell = np.sum(x, axis=1)
    
    # Apply threshold
    if min_counts is not None:
        cell_subset = number_per_cell >= float(min_counts)
    elif min_genes is not None:
        cell_subset = number_per_cell >= float(min_genes)
    elif max_counts is not None:
        cell_subset = number_per_cell <= float(max_counts)
    else:  # max_genes
        cell_subset = number_per_cell <= float(max_genes)
    
    return cell_subset, number_per_cell

def filter_cells_sparse_kernel(
    data: ndarray[float, 1], 
    indptr: ndarray[int, 1], 
    n_rows: int,
    min_counts: Optional[int] = None, 
    min_genes: Optional[int] = None, 
    max_counts: Optional[int] = None, 
    max_genes: Optional[int] = None
) -> Tuple[ndarray[bool, 1], ndarray[float, 1]]:
    """
    Filter cell outliers based on counts and numbers of genes expressed.
    Sparse kernel, runs on data and indptr. Does not take a full CSRMatrix
    Parameters
    ----------
    data: data array of sparse matrix
    indptr: indptr component of sparse matrix
    n_rows: shape[0] of sparse matrix
    min_counts, min_genes, max_counts, max_genes : Optional[int]
        Filtering thresholds (provide exactly one)
    
    Returns
    -------
    cell_subset : ndarray[bool, 1]
        Boolean mask of cells passing filter
    number_per_cell : ndarray[float, 1]
        Counts or genes per cell
    """
    mask = np.ones(n_rows, dtype=bool)
    number_per_cell = np.zeros(n_rows, dtype=float)

    check_counts: bool = (min_counts is not None) or (max_counts is not None)
    check_genes: bool  = (min_genes is not None) or (max_genes is not None)
    
    for i in range(n_rows):
        start = indptr[i]
        end = indptr[i+1]
        
        if check_genes:
            n_genes = float(end - start)
            number_per_cell[i] = n_genes
            if (min_genes is not None and n_genes < float(min_genes)) or \
               (max_genes is not None and n_genes > float(max_genes)):
                mask[i] = False
                continue # Skip count check if already failed
        else:
            row_sum = 0.0
            for ptr in range(start, end):
                row_sum += data[ptr]
            number_per_cell[i] = row_sum
                
        if check_counts:
            # If check_genes was true, row_sum is not computed yet
            if check_genes:
                row_sum = 0.0
                for ptr in range(start, end):
                    row_sum += data[ptr]

            if (min_counts is not None and row_sum < float(min_counts)) or \
               (max_counts is not None and row_sum > float(max_counts)):
                mask[i] = False
                
    return mask, number_per_cell

def filter_genes_dense_kernel(
    x: ndarray[float, 2],
    min_counts: Optional[int] = None,
    min_cells: Optional[int] = None,
    max_counts: Optional[int] = None,
    max_cells: Optional[int] = None,
) -> Tuple[ndarray[bool, 1], ndarray[float, 1]]:
    """
    Filter genes based on number of cells or counts.
    Dense kernel
    Parameters
    ----------
    x : ndarray[float, 2]
        Expression matrix (cells x genes)
    min_counts, min_cells, max_counts, max_cells : Optional[int]
        Filtering thresholds (provide exactly one)
    
    Returns
    -------
    gene_subset : ndarray[bool, 1]
        Boolean mask of genes passing filter
    number_per_gene : ndarray[float, 1]
        Counts or cells per gene
    """
    # Compute counts or cells per gene
    if min_cells is not None or max_cells is not None:
        number_per_gene = np.sum(x > 0.0, axis=0).astype(np.float64)
    else:
        number_per_gene = np.sum(x, axis=0)
    
    # Apply threshold
    if min_counts is not None:
        gene_subset = number_per_gene >= float(min_counts)
    elif min_cells is not None:
        gene_subset = number_per_gene >= float(min_cells)
    elif max_counts is not None:
        gene_subset = number_per_gene <= float(max_counts)
    else:  # max_cells
        gene_subset = number_per_gene <= float(max_cells)
    
    return gene_subset, number_per_gene

def filter_genes_sparse_kernel(
    data: ndarray[float, 1], 
    indices: ndarray[int, 1], 
    n_cols: int,
    min_counts: Optional[int] = None, 
    min_cells: Optional[int] = None, 
    max_counts: Optional[int] = None, 
    max_cells: Optional[int] = None
) -> Tuple[ndarray[bool, 1], ndarray[float, 1]]:
    """
    Filter genes based on number of cells or counts.
    Sparse kernel, runs on data and indices
    Parameters
    ----------
    data: ndarray[float, 1]
        data component of sparse matrix
    indices: ndarray[int, 1]
        indices componet of sparse matrix
    n_cols: int
        shape[1] of sparse matrix
    min_counts, min_cells, max_counts, max_cells : Optional[int]
        Filtering thresholds (provide exactly one)
    
    Returns
    -------
    gene_subset : ndarray[bool, 1]
        Boolean mask of genes passing filter
    number_per_gene : ndarray[float, 1]
        Counts or cells per gene
    
    """
    mask = np.ones(n_cols, dtype=bool)
    check_counts: bool = (min_counts is not None) or (max_counts is not None)
    check_cells: bool  = (min_cells is not None)  or (max_cells is not None)
    
    # Accumulate column stats in a single flat pass
    col_counts = np.zeros(n_cols, dtype=float)
    col_cells = np.zeros(n_cols, dtype=float)
    
    for ptr in range(len(data)):
        col_idx = indices[ptr]
        if check_cells:
            # Assumes explicit zeros are dropped; every entry is a "cell" hit
            col_cells[col_idx] += 1.0 
            if check_counts:
                col_counts[col_idx] += data[ptr]
        else:
            col_counts[col_idx] += data[ptr]
            
    for j in range(n_cols):
        if check_cells:
            c = col_cells[j]
            if (min_cells is not None and c < float(min_cells)) or \
               (max_cells is not None and c > float(max_cells)):
                mask[j] = False
                continue
                
        if check_counts:
            c = col_counts[j]
            if (min_counts is not None and c < float(min_counts)) or \
               (max_counts is not None and c > float(max_counts)):
                mask[j] = False
                
    number_per_gene = col_cells if check_cells else col_counts
    return mask, number_per_gene
    

def log1p_dense_kernel(x: ndarray[float, 2], base: Optional[float] = None) -> ndarray[float, 2]:
    """Logarithmize the data matrix: X = log(X + 1).
    
    Parameters
    ----------
    x : ndarray[float, 2]
        Expression matrix (modified in-place)
    base : Optional[float]
        Logarithm base (default is natural log)
    
    Returns
    -------
    ndarray[float, 2]
        Log-transformed matrix (same object, modified in-place)
    """
    np.log1p(x, out=x)
    
    if base is not None:
        np.divide(x, np.log(base), out=x)
    
    return x

def log1p_sparse_kernel(data: ndarray[float, 1], base: Optional[float] = None) ->ndarray[float, 1]:
    '''
    Logarithmize the data matrix: X = log(X + 1). Sparse kernel that runs directly on data array
    Parameters
    ----------
    data: ndarray[float, 1]
        data component of sparse matrix
    base : Optional[float]
        Logarithm base (default is natural log)
    
    Returns
    -------
    ndarray[float, 2]
        Log-transformed matrix (same object, modified in-place)
    '''
    # we can do this easily just be iterating the value array
    has_base: bool = False
    if base is not None:
        has_base = base > 0.0
    log_base: float = math.log(base) if has_base else 1.0
    @par
    for i in range(len(data)):
        val = math.log1p(data[i])
        if has_base:
            val /= log_base
        data[i] = val
    return data

def sqrt_kernel(x: ndarray[float, 2]) -> ndarray[float, 2]:
    """Take square root of the data matrix: X = sqrt(X).
    
    Parameters
    ----------
    x : ndarray[float, 2]
        Expression matrix (modified in-place)
    
    Returns
    -------
    ndarray[float, 2]
        Square-root transformed matrix (same object, modified in-place)
    """
    np.sqrt(x, out=x)
    
    return x


def regress_out_kernel(data: ndarray[float, 2], regressors: ndarray[float, 2]) -> ndarray[float, 2]:
    """Dense linear regression residuals.

    Parameters
    ----------
    data : ndarray[float, 2] (n_obs x n_vars)
        Expression matrix to be residualized.
    regressors : ndarray[float, 2] (n_obs x n_regressors)
        Design matrix including intercept column.

    Returns
    -------
    ndarray[float, 2]
        Residual matrix with the same shape as ``data``.
    """
    gram = regressors.T @ regressors
    coeff = np.linalg.solve(gram, regressors.T @ data)
    fitted = regressors @ coeff
    np.subtract(data, fitted, out=data)
    return data
