'''native codon implementation of calculate_qc_metrics'''

import numpy as np
from typing import Optional, Tuple, int
from numpy import ndarray
from .._csr import CSRMatrix
from math import log1p


def calculate_qc_metrics(
    x: CSRMatrix,
    qc_masks: List[ndarray[bool, 1]],
    expr_type = "counts", 
    var_type = "genes",
    percent_top: Optional[List[int]] = [50, 100, 200, 500],
    log1p_metrics: bool = True,
) -> Tuple[
    # obs_metrics
    Tuple[
        ndarray[int, 1],   # nnz
        ndarray[float, 1], # log1p_nnz
        ndarray[float, 1], # totals
        ndarray[float, 1], # log1p_totals
        ndarray[float, 2], # props (n_rows, len(percent_top))
        ndarray[float, 2], # qc_totals (n_rows, n_qc)
        ndarray[float, 2], # log1p_qc_totals (n_rows, n_qc)
        ndarray[float, 2]  # qc_pcts (n_rows, n_qc)
    ],
    # var_metrics
    Tuple[
        ndarray[int, 1],   # nnz
        ndarray[float, 1], # means
        ndarray[float, 1], # log1p_means
        ndarray[float, 1], # dropout
        ndarray[float, 1], # totals
        ndarray[float, 1], # log1p_totals
    ]
]:

    obs_metrics = describe_obs(
        x=x,
        qc_masks=qc_masks,
        percent_top=percent_top,
        log1p_metrics=log1p_metrics,
    )

    var_metrics = describe_var(
        x=x,
        log1p_metrics=log1p_metrics,
    )

    return (obs_metrics, var_metrics)

def top_proportions_dense(mtx: ndarray, n: int):
    # compute top proportions for a dense matrix
    sums = mtx.sum(axis=1)
    partitioned = np.apply_along_axis(np.argpartition, 1, -mtx, n-1)
    partitioned = partitioned[:, :n]
    values = np.zeros_like(partitioned, dtype= np.float64)
    for i in range(partitioned.shape[0]):
        vec = mtx[i, partitioned[i, :]]
        vec[::-1].sort()
        vec = np.cumsum(vec) / sums[i]
        values[i, :] = vec
    return values


def top_proportions_sparse_csr(
    mtx: CSRMatrix,
    n: int,
    ) -> ndarray[float, 2]:

    values = np.zeros((mtx.shape[0], n), dtype=np.float64)

    for i in range(mtx.shape[0]):
        start = mtx.indptr[i]
        end = mtx.indptr[i + 1]

        vec = np.zeros(n, dtype=np.float64)

        if end - start <= n:
            vec[: end - start] = mtx.data[start:end]
            total = vec.sum()
        else:
            # largest n values (order not guaranteed)
            vec[:] = -(np.partition(-mtx.data[start:end], n - 1)[:n])
            total = np.sum(mtx.data[start:end])

        # sort descending
        vec[::-1].sort()

        # convert to cumulative proportions
        values[i, :] = np.cumsum(vec) / total

    return values

def top_segment_proportions_sparse_csr(
    mtx: CSRMatrix,
    ns: ndarray[int, 1],
) -> ndarray[float, 2]:

    ns = np.sort(ns)

    maxidx = ns[-1]
    n_rows = mtx.shape[0]
    n_ns = len(ns)

    values = np.zeros((n_rows, n_ns), dtype=np.float64)

    # Scratch buffer reused for every row
    scratch = np.zeros(maxidx, dtype=np.float64)

    for i in range(n_rows):
        start = mtx.indptr[i]
        end = mtx.indptr[i + 1]

        row = mtx.data[start:end]
        nnz = end - start

        total = np.sum(row)

        scratch[:] = 0.0

        if nnz <= maxidx:
            scratch[:nnz] = row
        else:
            scratch[:] = (-np.partition(-row, maxidx))[:maxidx]

        scratch[::-1].sort()

        acc = 0.0
        prev = 0

        for j in range(n_ns):
            # Codon natively handles slicing sum quickly
            acc += np.sum(scratch[prev:ns[j]])
            if total > 0:
                values[i, j] = acc / total
            else:
                values[i, j] = 0.0
            prev = ns[j]

    return values


def describe_obs(
    x: CSRMatrix,
    qc_masks: List[ndarray[bool, 1]],
    percent_top: List[int],
    log1p_metrics: bool = True,
    ) -> Tuple[
    ndarray[int, 1], ndarray[float, 1], ndarray[float, 1], ndarray[float, 1],
    ndarray[float, 2], ndarray[float, 2], ndarray[float, 2], ndarray[float, 2]
    ]:

    n_rows = x.shape[0]
    n_qc = len(qc_masks)
    n_percent = len(percent_top)

    # Pre-allocate output arrays
    nnz = np.zeros(n_rows, dtype=np.int64)
    log1p_nnz = np.zeros(n_rows, dtype=float)
    totals = np.zeros(n_rows, dtype=float)
    log1p_totals = np.zeros(n_rows, dtype=float)
    
    qc_totals = np.zeros((n_rows, n_qc), dtype=float)
    log1p_qc_totals = np.zeros((n_rows, n_qc), dtype=float)
    qc_pcts = np.zeros((n_rows, n_qc), dtype=float)

    # 1. Single-pass loop for high cache-locality
    for row in range(n_rows):
        start = x.indptr[row]
        end = x.indptr[row + 1]
        
        row_nnz = end - start
        nnz[row] = row_nnz
        if log1p_metrics:
            log1p_nnz[row] = log1p(float(row_nnz))

        s = 0.0
        # Compute row total and qc totals simultaneously
        for idx in range(start, end):
            val = x.data[idx]
            s += val
            
            col = x.indices[idx]
            for q in range(n_qc):
                if qc_masks[q][col]:
                    qc_totals[row, q] += val
        
        totals[row] = s
        if log1p_metrics:
            log1p_totals[row] = log1p(s)

        # Finalize qc percentages
        for q in range(n_qc):
            q_sum = qc_totals[row, q]
            if log1p_metrics:
                log1p_qc_totals[row, q] = log1p(q_sum)
            if s > 0.0:
                qc_pcts[row, q] = 100.0 * q_sum / s

    # 2. Top proportions calculation
    if n_percent > 0:
        ns = np.array(sorted(percent_top))
        props = top_segment_proportions_sparse_csr(x, ns)
        # Convert to percentages inplace
        for i in range(n_rows):
            for j in range(n_percent):
                props[i, j] *= 100.0
    else:
        props = np.zeros((n_rows, 0), dtype=float)

    return (nnz, log1p_nnz, totals, log1p_totals, props, qc_totals, log1p_qc_totals, qc_pcts)


def describe_var(
    x: CSRMatrix,
    log1p_metrics: bool = True,
) -> Tuple[
    ndarray[int, 1], ndarray[float, 1], ndarray[float, 1], 
    ndarray[float, 1], ndarray[float, 1], ndarray[float, 1]
]:

    n_rows = x.shape[0]
    n_cols = x.shape[1]

    nnz = np.zeros(n_cols, dtype=np.int64)
    totals = np.zeros(n_cols, dtype=float)

    # Accumulate column stats by iterating CSR structure
    for row in range(n_rows):
        start = x.indptr[row]
        end = x.indptr[row + 1]

        for idx in range(start, end):
            col = x.indices[idx]
            nnz[col] += 1
            totals[col] += x.data[idx]

    means = np.zeros(n_cols, dtype=float)
    log_means = np.zeros(n_cols, dtype=float)
    dropout = np.zeros(n_cols, dtype=float)
    log_totals = np.zeros(n_cols, dtype=float)

    n_rows_float = float(n_rows)

    for col in range(n_cols):
        means[col] = totals[col] / n_rows_float
        dropout[col] = 100.0 * (1.0 - float(nnz[col]) / n_rows_float)
        
        if log1p_metrics:
            log_means[col] = log1p(means[col])
            log_totals[col] = log1p(totals[col])

    return (nnz, means, log_means, dropout, totals, log_totals)

def masked_row_sum(
    x: CSRMatrix,
    mask: ndarray[bool, 1]
) -> ndarray[float, 1]:
    """
    Sum entries in each row whose column satisfies mask[col].
    Equivalent to Scanpy's:
        stats.sum(x[:, mask], axis=1)
    but avoids constructing a temporary sparse matrix.
    """
    out = np.zeros(x.nrows, dtype=float)

    for row in range(x.nrows):
        total = 0.0

        for idx in range(x.indptr[row], x.indptr[row + 1]):
            if mask[x.indices[idx]]:
                total += x.data[idx]

        out[row] = total

    return out


