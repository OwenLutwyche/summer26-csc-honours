# Pure Codon kernel for scanpy.preprocessing._scale
# This function accepts numpy arrays only - no AnnData objects

import numpy as np
from numpy import ndarray
from typing import Optional, Tuple
import math
from .._csr import CSRMatrix


def _ensure_dense(x):
    """Convert sparse matrix to dense if needed."""
    if hasattr(x, "toarray"):
        return x.toarray()
    return x


def scale_dense_kernel(
    x: ndarray[float, 2],
    zero_center: bool = True,
    max_value: Optional[float] = None,
    mask_obs: Optional[ndarray[bool, 1]] = None,
) -> Tuple[ndarray[float, 2], ndarray[float, 1], ndarray[float, 1]]:
    """
    scale data to unit variance and zero mean.
    Parameters
    ----------
    x : np.ndarray
        Expression matrix (cells x genes), modified in-place
    zero_center : bool
        If False, omit zero-centering
    max_value : Optional[float]
        Clip to this value after scaling
    mask_obs : Optional[np.ndarray]
        Boolean mask for observations to use for computing mean/std
    
    Returns
    -------
    x : np.ndarray
        Scaled matrix (same object, modified in-place)
    mean : np.ndarray
        Mean per gene
    std : np.ndarray
        Standard deviation per gene
    """
    print("[CODON] scale dense kernel")
    n_rows = x.shape[0]
    n_cols = x.shape[1]

    mean = np.zeros(n_cols, dtype=float)
    std = np.zeros(n_cols, dtype=float)

    # determine effective number of observations
    n_stats = 0
    if mask_obs is not None:
        for i in range(n_rows):
            if mask_obs[i]:
                n_stats += 1
    else:
        n_stats = n_rows

    if n_stats == 0:
        return x, mean, std

    # compute mean (column-wise accumulation, row-major traversal for cache locality)
    col_sums = np.zeros(n_cols, dtype=float)
    for i in range(n_rows):
        if mask_obs is None or mask_obs[i]:
            for j in range(n_cols):
                col_sums[j] += x[i, j]

    inv_n_stats = 1.0 / float(n_stats)
    for j in range(n_cols):
        mean[j] = col_sums[j] * inv_n_stats

    # stdev
    var_sums = np.zeros(n_cols, dtype=float)
    for i in range(n_rows):
        if mask_obs is None or mask_obs[i]:
            for j in range(n_cols):
                diff = x[i, j] - mean[j]
                var_sums[j] += diff * diff

    div = float(n_stats - 1) if n_stats > 1 else 1.0
    for j in range(n_cols):
        std[j] = math.sqrt(var_sums[j] / div)
        if std[j] == 0.0:
            std[j] = 1.0  # avoid division by zero

    # unbox optional before the tight loop to prevent inference overhead
    do_clip = False
    clip_val = 0.0
    if max_value is not None:
        do_clip = True
        clip_val = float(max_value)

    # scale and clip in-place
    # using prange to parallelize across rows automatically utilizes all CPU cores
    for i in range(n_rows):
        for j in range(n_cols):
            val = x[i, j]
            
            if zero_center:
                val -= mean[j]
                
            val /= std[j]

            if do_clip:
                if zero_center:
                    if val > clip_val: val = clip_val
                    elif val < -clip_val: val = -clip_val
                else:
                    if val > clip_val: val = clip_val

            x[i, j] = val

    return x, mean, std

def scale_sparse_kernel(
    x: CSRMatrix, 
    max_value: Optional[float] = None,
    mask_obs: Optional[ndarray[bool, 1]] = None,
    ) -> Tuple[CSRMatrix, ndarray[float, 1], ndarray[float, 1]]:
    """
    Scale sparse data to unit variance. 
    Zero-centering is inherently omitted to preserve sparsity.
    
    Parameters
    ----------
    x : CSRMatrix
        Expression matrix (cells x genes), modified in-place
    max_value : Optional[float]
        Clip to this value after scaling
    mask_obs : Optional[ndarray[bool, 1]]
        Boolean mask for cells (rows) to use for computing mean/std
    
    Returns
    -------
    x : CSRMatrix
    mean : ndarray[float, 1]
    std : ndarray[float, 1]
    """
    print("[CODON] scale sparse kernel")
    
    n_rows = x.shape[0]
    n_cols = x.shape[1]
    
    # determine effective number of observations
    n_stats = 0
    if mask_obs is not None:
        for i in range(n_rows):
            if mask_obs[i]:
                n_stats += 1
    else:
        n_stats = n_rows
        
    mean = np.zeros(n_cols, dtype=float)
    std = np.zeros(n_cols, dtype=float)
    
    if n_stats <= 1:
        # cannot compute variance safely, return unmodified with std=1
        for j in range(n_cols):
            std[j] = 1.0
        return x, mean, std

    # compute Mean and Variance in one pass over the masked rows
    col_sums = np.zeros(n_cols, dtype=float)
    col_sq_sums = np.zeros(n_cols, dtype=float)
    
    for i in range(n_rows):
        # only accumulate statistics if the row is unmasked
        if mask_obs is None or mask_obs[i]:
            start = x.indptr[i]
            end = x.indptr[i + 1]
            for ptr in range(start, end):
                col = x.indices[ptr]
                val = x.data[ptr]
                
                col_sums[col] += val
                col_sq_sums[col] += val * val
                
    # finalize mean and std arrays
    div = float(n_stats - 1)
    inv_n_stats = 1.0 / float(n_stats)
    
    for j in range(n_cols):
        mean[j] = col_sums[j] * inv_n_stats
        
        # calculate variance using accumulated sums and squares
        var = (col_sq_sums[j] - (col_sums[j] * col_sums[j] * inv_n_stats)) / div
        
        # floating point safety for near-zero or negative variances
        if var <= 0.0:
            std[j] = 1.0
        else:
            std[j] = math.sqrt(var)
            if std[j] == 0.0:
                std[j] = 1.0

    # unbox Optional variables before the tight loop
    do_clip = False
    clip_val = 0.0
    if max_value is not None:
        do_clip = True
        clip_val = float(max_value)
        
    # scale and clip In-Place
    # Because we are dividing by std (and NOT subtracting the mean), the sparsity structure is preserved perfectly. 
    # ignore rows entirely and just iterate over the flat data array!
    nnz = len(x.data)
    for ptr in range(nnz):
        col = x.indices[ptr]
        
        val = x.data[ptr] / std[col]
        
        if do_clip:
            if val > clip_val: val = clip_val
            elif val < -clip_val: val = -clip_val
            
        x.data[ptr] = val
        
    return x, mean, std