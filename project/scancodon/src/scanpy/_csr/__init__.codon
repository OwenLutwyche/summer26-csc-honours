# native codon implementation of Compressed Sparse Row Matrix

import numpy as np
import math
from numpy import ndarray
from typing import Tuple

# this is ONLY so that we can cast it as our CSRMatrix!
from python import scipy.sparse as sp_sparse



class CSRMatrix: 
    data: ndarray[float, 1]     # nonzero values
    indices: ndarray[int, 1]    # column indices of nonzero values - MUST REMAIN SORTED: no support for insertion/removal, only overwrite values at indices
    indptr: ndarray[int, 1]     # raw pointers length n_obs+1
    shape: Tuple[int, int]      # (n_obs, n_vars)

    @property
    def T(self) -> 'CSRMatrix':
        """property for matrix transpose."""
        return self.transpose()
    
    def __init__(self, 
                 data: ndarray[float, 1],
                 indices: ndarray[int, 1],
                 indptr: ndarray[int, 1],
                 shape: Tuple[int, int],
                 ):
        assert len(indptr) == shape[0] + 1, f"Invalid CSR: shape[0]={shape[0]}, but len(indptr)={len(indptr)}"
        self.data = data
        self.indices = indices
        self.indptr = indptr
        self.shape = shape
    
    def __getitem__(self, pos: Tuple[int, int]) -> float:
        '''
        binary search getitem, called with self[pos]
        '''
        row, col = pos
        if row < 0 or row >= self.shape[0] or col < 0 or col >= self.shape[1]:
            raise IndexError("index out of bounds")
        
        start = self.indptr[row]
        end = self.indptr[row + 1]

        # binary search through column indices
        low = start
        high = end - 1
        while low <= high:
            mid = low + (high - low) // 2
            v = self.indices[mid]
            if v == col:
                return self.data[mid]
            elif v < col:
                low = mid + 1
            else:
                #v > col:
                high = mid - 1
        
        # if we can't find it in our list of nonzero values and it's not out of bounds then it must be zero
        return 0.0
    
    def __setitem__(self, pos:Tuple[int, int], value: float):
        '''
        overwrite value located at pos
        '''
        row, col = pos
        if row < 0 or row >= self.shape[0] or col < 0 or col >= self.shape[1]:
            raise IndexError("index out of bounds")

        start = self.indptr[row]
        end = self.indptr[row + 1]

        left = start
        right = end - 1
        while left <= right:
            mid = left + (right - left) // 2
            c = self.indices[mid]
            if c == col:
                # The non-zero element already exists, update it in place
                self.data[mid] = value
                return
            elif c < col:
                left = mid + 1
            else:
                right = mid - 1

        # target cell must be zero.
        if value == 0.0:
            return  # Setting a zero to a zero is free

        # Inserting a completely new non-zero value into CSR doesn't work
        # it requires reallocating/shifting the entire data and indices arrays.
        raise ValueError("Cannot insert new non-zero element into CSR format. Construct using COO format first, or only update existing non-zero entries.")
    
    def __neg__(self) -> 'CSRMatrix':
        '''
        apply negative sign to all values
        '''
        # Allocate a new array for the negated data
        negative_data: ndarray[float, 1] = np.zeros((len(self.data),), dtype=float)
        for i in range(len(self.data)):
            negative_data[i] = -self.data[i]
        # Reuse the existing indptr and indices arrays since the structure is identical
        return CSRMatrix(
            negative_data, 
            self.indices, 
            self.indptr, 
            self.shape
        )

    def __add__(self, other: 'CSRMatrix') -> 'CSRMatrix':
        '''
        matrix addition for CSR matrices
        '''
        if self.shape != other.shape:
            raise ValueError("Dimension mismatch for addition")
            
        n_rows, n_cols = self.shape
        
        # use coodon's native lists to build the dynamic arrays, 
        # then cast to ndarray at the end
        data_list: List[float] = []
        indices_list: List[int] = []
        indptr: ndarray[int, 1] = np.zeros((n_rows + 1,), dtype=int)
        
        for i in range(n_rows):
            indptr[i] = len(data_list)
            
            ptr_a = self.indptr[i]
            end_a = self.indptr[i+1]
            ptr_b = other.indptr[i]
            end_b = other.indptr[i+1]
            
            # Two-pointer merge for the current row
            while ptr_a < end_a and ptr_b < end_b:
                col_a = self.indices[ptr_a]
                col_b = other.indices[ptr_b]
                
                if col_a < col_b:
                    data_list.append(self.data[ptr_a])
                    indices_list.append(col_a)
                    ptr_a += 1
                elif col_a > col_b:
                    data_list.append(other.data[ptr_b])
                    indices_list.append(col_b)
                    ptr_b += 1
                else:
                    # Columns match, add the values
                    val = self.data[ptr_a] + other.data[ptr_b]
                    if val != 0.0:  # Prevent storing explicit zeros
                        data_list.append(val)
                        indices_list.append(col_a)
                    ptr_a += 1
                    ptr_b += 1
                    
            # Drain any remaining elements in row i
            while ptr_a < end_a:
                data_list.append(self.data[ptr_a])
                indices_list.append(self.indices[ptr_a])
                ptr_a += 1
                
            while ptr_b < end_b:
                data_list.append(other.data[ptr_b])
                indices_list.append(other.indices[ptr_b])
                ptr_b += 1
                
        indptr[n_rows] = len(data_list)
        
        return CSRMatrix(
            np.array(data_list, dtype=float), 
            np.array(indices_list, dtype=int), 
            indptr, 
            self.shape
        )

    def __sub__(self, other: 'CSRMatrix') -> 'CSRMatrix':
        # let __add__ and __neg__ handle it
        return self + -other

    def __matmul__(self, other: 'CSRMatrix') -> 'CSRMatrix':
        '''
        matrix multiplication for CSR matrices
        '''
        if self.shape[1] != other.shape[0]:
            raise ValueError("Dimension mismatch for matrix multiplication")
        
        n_rows = self.shape[0]
        n_cols = other.shape[1]
        
        data_list: List[float] = []
        indices_list: List[int] = []
        indptr: ndarray[int, 1] = np.zeros((n_rows + 1,), dtype=int)
        
        # The Sparse Accumulator (SPA)
        row_accum: ndarray[float, 1] = np.zeros((n_cols,), dtype=float)
        active_cols: List[int] = []
        
        for i in range(n_rows):
            indptr[i] = len(data_list)
            
            # Iterate over non-zeros in row i of A
            for j_ptr in range(self.indptr[i], self.indptr[i+1]):
                k = self.indices[j_ptr]
                val_A = self.data[j_ptr]
                
                # Multiply by the corresponding row k of B
                for k_ptr in range(other.indptr[k], other.indptr[k+1]):
                    col_B = other.indices[k_ptr]
                    val_B = other.data[k_ptr]
                    
                    # If this is the first time touching this column, track it
                    if row_accum[col_B] == 0.0:
                        active_cols.append(col_B)
                    
                    row_accum[col_B] += val_A * val_B
            
            # Extract the results from the accumulator, ensure sorted order
            active_cols.sort()
            for col in active_cols:
                val = row_accum[col]
                if val != 0.0:
                    data_list.append(val)
                    indices_list.append(col)
                # Reset accumulator for the next row
                row_accum[col] = 0.0 
            
            active_cols.clear()
            
        indptr[n_rows] = len(data_list)
        
        return CSRMatrix(
            np.array(data_list, dtype=float), 
            np.array(indices_list, dtype=int), 
            indptr, 
            (n_rows, n_cols)
        )

    def dot(self, other: 'CSRMatrix') -> 'CSRMatrix':
        '''
        alias matrix multiplication just in case we accidentally call dot product
        '''
        return self.__matmul__(other)
    
    def sum_total(self) -> float:
        '''
        add all the values in the matrix, like ndarray with sum(axis=None)
        '''
        total = 0.0
        for datum in self.data:
            total+=datum
        return total
    
    def sum(self, axis=0) ->ndarray[float, 1]:
        '''
        add all the values in the axis, like ndarray with sum(axis = 1 or 0)
        '''
        # might as well just dispatch to separate functions since they're similar logic but fundamentally different
        if axis == 0:
            return self.sum0()
        elif axis ==1:
            return self.sum1()
        else:
            raise IndexError("out of bounds")

    def sum0(self) -> ndarray[float, 1]:
        '''
        sum the 0 axis
        '''
        n_cols = self.shape[1]
        result: ndarray[float, 1] = np.zeros((n_cols,), dtype=float)
        for i in range(len(self.data)):
            col_idx = self.indices[i]
            result[col_idx] += self.data[i]
        return result

    
    def sum1(self) -> ndarray[float, 1]:
        '''
        sum the 1 axis
        '''
        n_rows = self.shape[0]
        result: ndarray[float, 1] = np.zeros((n_rows,), dtype=float)
        for i in range(n_rows):
            # get indptr to cover the contiguous values in this row
            start = self.indptr[i]
            end = self.indptr[i + 1]
            row_sum = 0.0
            for j in range(start, end):
                row_sum += self.data[j]
            result[i] = row_sum
        return result
    
    def scale_rows_inplace(self, scales: ndarray[float, 1]):
        """
        Scales each row's data by a corresponding scalar.
        Equivalent to multiplying by a diagonal matrix from the left.
        """
        n_rows = self.shape[0]
        if scales.shape[0] != n_rows:
            raise ValueError("Scales array length must match number of rows.")
            
        for i in range(n_rows):
            start = self.indptr[i]
            end = self.indptr[i + 1]
            s = scales[i]
            
            # Directly modify the contiguous data slice for this row
            for ptr in range(start, end):
                self.data[ptr] *= s

    def mean_total(self) -> float:
        '''
        mean of the whole matrix
        '''
        total = 0.0
        for datum in self.data:
            total+=datum
        return total / len(self.data)


    def mean(self, axis=0) ->ndarray[float, 1]:
        '''
        mean of a single axis
        '''
        if axis == 0:
            return self.mean0()
        elif axis == 1:
            return self.mean1()
        else:
            raise IndexError("out of bounds")
        
    def mean0(self) -> ndarray[float, 1]:
        sums = self.sum0()
        n_rows = float(self.shape[0])
        if n_rows > 0.0:
            sums /= n_rows

        return sums

    def mean1(self) -> ndarray[float, 1]:
        sums = self.sum1()
        n_cols = float(self.shape[1])
        if n_cols > 0.0:
            sums /= n_cols  
        return sums

    def to_dense(self) -> ndarray[float, 2]:
        '''
        Convert CSRMatrix to a dense ndarray[float, 2].
        '''
        n_rows, n_cols = self.shape
        dense: ndarray[float, 2] = np.zeros((n_rows, n_cols), dtype=float)
        for i in range(n_rows):
            start: int = int(self.indptr[i])
            end: int = int(self.indptr[i + 1])
            for j in range(start, end):
                col: int = int(self.indices[j])
                dense[i, col] = self.data[j]
        return dense

    def log1p_inplace(self, base: float = -1.0):
        """
        Applies log1p to all non-zero elements in-place.
        If base is > 0, performs change-of-base division.
        """
        has_base: bool = base > 0.0
        log_base: float = math.log(base) if has_base else 1.0
        
        # literally only need to iterate the array
        for i in range(len(self.data)):
            val = math.log1p(self.data[i])
            if has_base:
                val /= log_base
            self.data[i] = val
    
    def get_row(self, row_idx: int) -> Tuple[ndarray[float, 1], ndarray[int, 1]]:
        """
        Extracts the non-zero data and column indices for a specific row.
        Returns (data_slice, indices_slice).
        """
        if row_idx < 0 or row_idx >= self.shape[0]:
            raise IndexError("row index out of bounds")
        
        start = self.indptr[row_idx]
        end = self.indptr[row_idx + 1]
        
        return self.data[start:end], self.indices[start:end]
    

    def transpose(self) -> 'CSRMatrix':
        """
        computes the transpose of the CSRMatrix.
        """
        n_rows, n_cols = self.shape
        nnz = len(self.data)
        
        new_indptr = np.zeros((n_cols + 1,), dtype=int)
        new_indices = np.zeros((nnz,), dtype=int)
        new_data = np.zeros((nnz,), dtype=float)
        
        # count nonzeros per column in the original matrix.
        # we use the nonzeros per column as the nonzeros per row in the transposed matrix, pretty intuitive
        for i in range(nnz):
            col = self.indices[i]
            new_indptr[col + 1] += 1
            
        # compute cumulative sum to get the transposed row pointers
        for i in range(1, n_cols + 1):
            new_indptr[i] += new_indptr[i - 1]
            
        # distribute the data and swap the indices
        # We need a copy of indptr to track insertion positions
        current_ptrs = np.zeros((n_cols,), dtype=int)
        for i in range(n_cols):
            current_ptrs[i] = new_indptr[i]
            
        for r in range(n_rows):
            start = self.indptr[r]
            end = self.indptr[r + 1]
            for p in range(start, end):
                c = self.indices[p]
                v = self.data[p]
                
                # The row in the transposed matrix is 'c'
                dest = current_ptrs[c]
                new_indices[dest] = r
                new_data[dest] = v
                
                current_ptrs[c] += 1
                
        return CSRMatrix(new_data, new_indices, new_indptr, (n_cols, n_rows))
    
    def generate_doublet_matrix(self, pairs: ndarray[int, 2]) -> 'CSRMatrix':
        """
        Builds a new simulated CSRMatrix by adding pairs of rows from the current matrix.
        Necessary step in scrublet algorithm, located here for portability.
        Parameters:
        pairs : ndarray[int, 2] of shape (n_simulated, 2) containing the row indices to combine.
        """
        n_sim = pairs.shape[0]
        n_cols = self.shape[1]
        
        data_list: List[float] = []
        indices_list: List[int] = []
        indptr: ndarray[int, 1] = np.zeros((n_sim + 1,), dtype=int)
        
        for i in range(n_sim):
            indptr[i] = len(data_list)
            
            row_a = pairs[i, 0]
            row_b = pairs[i, 1]
            
            # Fetch pointers for the specific cells we are combining
            ptr_a = self.indptr[row_a]
            end_a = self.indptr[row_a + 1]
            
            ptr_b = self.indptr[row_b]
            end_b = self.indptr[row_b + 1]
            
            # Two-pointer merge for the synthetic doublet
            while ptr_a < end_a and ptr_b < end_b:
                col_a = self.indices[ptr_a]
                col_b = self.indices[ptr_b]
                
                if col_a < col_b:
                    data_list.append(self.data[ptr_a])
                    indices_list.append(col_a)
                    ptr_a += 1
                elif col_a > col_b:
                    data_list.append(self.data[ptr_b])
                    indices_list.append(col_b)
                    ptr_b += 1
                else:
                    # Columns match, transcript counts are added!
                    val = self.data[ptr_a] + self.data[ptr_b]
                    if val != 0.0:
                        data_list.append(val)
                        indices_list.append(col_a)
                    ptr_a += 1
                    ptr_b += 1
                    
            # Drain remaining transcripts
            while ptr_a < end_a:
                data_list.append(self.data[ptr_a])
                indices_list.append(self.indices[ptr_a])
                ptr_a += 1
                
            while ptr_b < end_b:
                data_list.append(self.data[ptr_b])
                indices_list.append(self.indices[ptr_b])
                ptr_b += 1
                
        # Cap the final pointer
        indptr[n_sim] = len(data_list)
        
        return CSRMatrix(
            np.array(data_list, dtype=float), 
            np.array(indices_list, dtype=int), 
            indptr, 
            (n_sim, n_cols)
        )
    
    def vstack(self, other: 'CSRMatrix') -> 'CSRMatrix':
        """
        Vertically stack this matrix with another CSRMatrix.
        Used to combine observed transcriptomes with simulated doublets.
        """
        if self.shape[1] != other.shape[1]:
            raise ValueError("Number of columns must match to vstack matrices.")
            
        n_rows_self = self.shape[0]
        n_rows_other = other.shape[0]
        new_n_rows = n_rows_self + n_rows_other
        n_cols = self.shape[1]
        
        nnz_self = len(self.data)
        nnz_other = len(other.data)
        new_nnz = nnz_self + nnz_other
        
        # Pre-allocate exact memory for the new arrays
        new_data: ndarray[float, 1] = np.zeros((new_nnz,), dtype=float)
        new_indices: ndarray[int, 1] = np.zeros((new_nnz,), dtype=int)
        new_indptr: ndarray[int, 1] = np.zeros((new_n_rows + 1,), dtype=int)
        
        # 1. Copy data and indices from self
        for i in range(nnz_self):
            new_data[i] = self.data[i]
            new_indices[i] = self.indices[i]
            
        # 2. Copy data and indices from other (offset by self's length)
        for i in range(nnz_other):
            new_data[nnz_self + i] = other.data[i]
            new_indices[nnz_self + i] = other.indices[i]
            
        # 3. Copy indptr from self
        for i in range(n_rows_self):
            new_indptr[i] = self.indptr[i]
            
        # 4. Copy and shift indptr from other
        # We iterate to n_rows_other + 1 to ensure the final boundary pointer is copied
        for i in range(n_rows_other + 1):
            new_indptr[n_rows_self + i] = other.indptr[i] + nnz_self
            
        return CSRMatrix(new_data, new_indices, new_indptr, (new_n_rows, n_cols))


# ------------------ outside CSRMatrix class -------------------------------
def empty_csr(n_rows: int, n_cols: int) -> CSRMatrix:
    '''
    Create an empty CSRMatrix of given shape with no non-zero entries. Here to help typechecking
    '''
    data: ndarray[float, 1] = np.zeros((0,), dtype=float)
    indices: ndarray[int, 1] = np.zeros((0,), dtype=int)
    indptr: ndarray[int, 1] = np.zeros((n_rows + 1,), dtype=int)
    return CSRMatrix(data, indices, indptr, (n_rows, n_cols))


def from_scipy_csr(sp_mat) -> CSRMatrix:
    '''
    Casts a scipy.sparse.csr_matrix into a scancodon.CSRMatrix.
    sp_mat is passed as a pyobj, then disassembled and reassembled as a CSRMatrix
    NOTE: This function should ideally not be necessary as __init__.py already 
    handles parsing of scipy.sparse.csr_matrix into its constituent arrays.
    This function persists because it may be useful sometime.
    '''
    # np.asarray on a pyobj infers ndarray[T, 0] regardless of annotation.
    # Calling .flatten() on the pyobj first returns a 1D pyobj array, then
    # np.array with an explicit annotation forces the correct ndarray[T, 1].
    shape: Tuple[int, int] = (int(sp_mat.shape[0]), int(sp_mat.shape[1]))
    nnz: int = int(sp_mat.nnz)
    data: ndarray[float, 1] = sp_mat.data.flatten().astype('float64').reshape((nnz,))
    indices: ndarray[int, 1] = sp_mat.indices.flatten().astype('int64').reshape((nnz,))
    indptr: ndarray[int, 1] = sp_mat.indptr.flatten().astype('int64').reshape((shape[0] + 1,))

    return CSRMatrix(data, indices, indptr, shape)


def from_dense(dense_mat: ndarray[float, 2]) -> CSRMatrix:
    '''
    converts an ordinary dense codon.np.ndarray to a superior codon.CSRMatrix
    sadly this will be costly, but hopefully we won't need to do it often
    '''
    rows: int = int(dense_mat.shape[0])
    cols: int = int(dense_mat.shape[1])

    # count nonzeros to preallocate arrays
    nnz = 0
    for i in range(rows):
        for j in range(cols):
            if dense_mat[i, j] != 0.0:
                nnz+=1

    # allocate
    data: ndarray[float, 1] = np.zeros((nnz,), dtype=float)
    indices: ndarray[int, 1] = np.zeros((nnz,), dtype=int)
    indptr: ndarray[int, 1] = np.zeros((rows + 1,), dtype=int)

    # insert data
    current_ptr = 0
    for i in range(rows):
        indptr[i] = current_ptr  # set the row pointer
        for j in range(cols):
            val = dense_mat[i, j]
            if val != 0.0:
                data[current_ptr] = val
                indices[current_ptr] = j
                current_ptr += 1
    indptr[rows] = current_ptr

    return CSRMatrix(data, indices, indptr, (rows, cols))

def from_coo(data: ndarray[float, 1],
             indices: Tuple[ndarray[int, 1], ndarray[int, 1]],
             shape: tuple[int, int]
             ) -> CSRMatrix:
    '''
    Builds a CSRMatrix from coordinate format
    to satisfy the relation a[row_ind[k], col_ind[k]] = data[k]
    Duplicate coordinates are summedd (following scipy behaviour)
    Input data in the same format as scipy: csr_matrix((data, (row_ind, col_ind)), [shape=(M, N)])
    '''
    row_ind, col_ind = indices
    nnz = len(data)
    n_rows, n_cols = shape
    
    if len(row_ind) != nnz or len(col_ind) != nnz:
        raise ValueError("data, row_ind, and col_ind must have the same length")
    
    # pack tuples so we can sort first by row and second by col
    # fill a big entries array
    entries: List[Tuple[int, int, float]] = []
    for i in range(nnz):
        entries.append((row_ind[i], col_ind[i], data[i]))
        
    entries.sort()

    out_data_list: List[float] = []
    out_indices_list: List[int] = []
    out_indptr: ndarray[int, 1] = np.zeros((n_rows + 1,), dtype=int)

    current_row = 0
    last_col = -1

    # drain entries into our csr format
    for i in range(nnz):
        r, c, v = entries[i]
        
        # jump forward with indptr for any empty rows we skipped
        while current_row < r:
            current_row += 1
            out_indptr[current_row] = len(out_data_list)
            last_col = -1
            
        if c == last_col and len(out_data_list) > 0:
            # SciPy resolution: sum duplicate coordinates
            out_data_list[-1] += v
        else:
            # Append new column entry
            out_data_list.append(v)
            out_indices_list.append(c)
            last_col = c

    # Fast-forward the indptr for any trailing empty rows at the bottom
    while current_row < n_rows:
        current_row += 1
        out_indptr[current_row] = len(out_data_list)

    return CSRMatrix(
        np.array(out_data_list, dtype=float),
        np.array(out_indices_list, dtype=int),
        out_indptr,
        shape
    )