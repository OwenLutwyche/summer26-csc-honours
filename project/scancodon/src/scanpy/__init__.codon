# src/scanpy/__init__.codon
# Top-level package entry point
# We wrap the submodule functions to force the compiler to export them.

from typing import Optional

import preprocessing as pp
import neighbors as nb
import tools as tl
import numpy as np
import math
from numpy import ndarray
from typing import Tuple
from ._csr import CSRMatrix, from_dense

# --- Preprocessing Wrappers ---
def log1p(x, base: Optional[float] = None):
    return pp.log1p(x, base)

def calculate_qc_metrics(X: ndarray[float, 2],
    data: ndarray[float, 1],
    indices: ndarray[int, 1],
    indptr: ndarray[int, 1],
    shape: Tuple[int, int],
    # Arguments
    qc_masks: List[ndarray[bool, 1]],
    expr_type: str = "counts", 
    var_type: str = "genes",
    percent_top: Optional[List[int]] = [50, 100, 200, 500],
    log1p_metrics: bool = True,
    ) -> Tuple[
    # obs_metrics
    Tuple[
        ndarray[int, 1],   # nnz
        ndarray[float, 1], # log1p_nnz
        ndarray[float, 1], # totals
        ndarray[float, 1], # log1p_totals
        ndarray[float, 2], # props (n_rows, len(percent_top))
        ndarray[float, 2], # qc_totals (n_rows, n_qc)
        ndarray[float, 2], # log1p_qc_totals (n_rows, n_qc)
        ndarray[float, 2]  # qc_pcts (n_rows, n_qc)
    ],
    # var_metrics
    Tuple[
        ndarray[int, 1],   # nnz
        ndarray[float, 1], # means
        ndarray[float, 1], # log1p_means
        ndarray[float, 1], # dropout
        ndarray[float, 1], # totals
        ndarray[float, 1], # log1p_totals
    ]
    ]:
    # Construct the CSRMatrix object directly from buffers
    X_csr = CSRMatrix(data, indices, indptr, shape)
    
    # Delegate to the processing logic
    return pp.calculate_qc_metrics(
        X_csr, 
        qc_masks, 
        percent_top=percent_top, 
        log1p_metrics=log1p_metrics
    )


def log1p_sparse(
    data: ndarray[float, 1], 
    indices: ndarray[int, 1], 
    indptr: ndarray[int, 1], 
    n_rows: int,             
    n_cols: int,             
    base: float
):
    # the log1p operation on a sparse matrix is literally just iterating the value array
    has_base: bool = base > 0.0
    log_base: float = math.log(base) if has_base else 1.0
            # for i in range(len(self.data)):
            # val = math.log1p(self.data[i])
            # if has_base:
            #     val /= log_base
            # self.data[i] = val
    for i in range(len(data)):
        val = math.log1p(data[i])
        if has_base:
            val /= log_base
        data[i] = val
    return data # done in place

    shape: Tuple[int, int] = (n_rows, n_cols)
    X_csr = CSRMatrix(data, indices, indptr, shape)
    X_csr.log1p_inplace(base)

def normalize_total(x, target_sum: float):
    return pp.normalize_total(x, target_sum)

def normalize_total_sparse(
    data: ndarray[float, 1], 
    indices: ndarray[int, 1], 
    indptr: ndarray[int, 1], 
    n_rows: int,
    n_cols: int,
    target_sum: float
) -> ndarray[float, 1]:
    return pp.normalize_total_sparse(data, indices, indptr, n_rows, n_cols, target_sum)

def filter_cells(
    x,
    min_counts: Optional[int] = None,
    min_genes: Optional[int] = None,
    max_counts: Optional[int] = None,
    max_genes: Optional[int] = None,
):
    return pp.filter_cells(x, min_counts, min_genes, max_counts, max_genes)

def filter_cells_sparse(
    data: ndarray[float, 1], 
    indptr: ndarray[int, 1], 
    n_rows: int,
    min_counts: float, 
    min_genes: float, 
    max_counts: float, 
    max_genes: float
    ) -> ndarray[bool, 1]:
    return pp.filter_cells_sparse(data, indptr, n_rows, min_counts, min_genes, max_counts, max_genes)


def scrublet(
    data: ndarray[float, 1],
    indices: ndarray[int, 1],
    indptr: ndarray[int, 1],
    n_rows: int,
    n_cols: int,
    sim_doublet_ratio: float,
    expected_doublet_rate: float,
    stdev_doublet_rate: float,
    random_state: int
    ) -> ndarray[float, 1]:
    return pp.scrublet(data, indices, indptr, n_rows, n_cols, sim_doublet_ratio, expected_doublet_rate, stdev_doublet_rate, random_state)


def pca(
    X: ndarray[float, 2], #
    n_comps: int = 50,
    zero_center: bool = True,
    standardize: bool = False,
) -> Tuple[ndarray[float, 2], ndarray[float, 2], ndarray[float, 1], ndarray[float, 1]]:
    # pass straight to pca
    return pp.pca(
        X,
        n_comps,
        zero_center,
        standardize
    )

def filter_genes(
    x,
    min_counts: Optional[int] = None,
    min_cells: Optional[int] = None,
    max_counts: Optional[int] = None,
    max_cells: Optional[int] = None,
):
    return pp.filter_genes(x, min_counts, min_cells, max_counts, max_cells)

def filter_genes_sparse(
    data: ndarray[float, 1], 
    indices: ndarray[int, 1], 
    n_cols: int,
    min_counts: float, 
    min_cells: float, 
    max_counts: float, 
    max_cells: float
    ) -> ndarray[bool, 1]:
    return pp.filter_genes_sparse(data, indices, n_cols, min_counts, min_cells, max_counts, max_cells)

def scale(x, zero_center: bool, max_value: Optional[float] = None):
    return pp.scale(x, zero_center, max_value)

def highly_variable_genes_seurat_dense(x, n_top_genes: int):
    return pp.highly_variable_genes_seurat_dense(x, n_top_genes)

def regress_out(x, regressors):
    return pp.regress_out(x, regressors)

# --- Neighbors Wrappers ---
def neighbors(x, n_neighbors: int, kernel: str = "auto"):
    return nb.neighbors(x, n_neighbors, kernel)

# --- Tools Wrappers ---
def leiden(adata):
    # Pass through args as needed, or simplifed
    tl.leiden(adata)

def umap(adata):
    tl.umap(adata)

def rank_genes_groups_dispatcher(X, groups_masks, method, ireference: int= -1):
    # handle type conversion of ireference from pyobj to codon int
    # very straightforward pyobj -> Optional[int], remember this for later
    iref: Optional[int] = None
    # unambiguous ireference -1 = None
    if ireference >= 0:
        iref = ireference
    return tl.rank_genes_groups_dispatcher(X, groups_masks, method, iref)