def scale_dense(x, zero_center: bool, max_value: Optional[float] = None, mask_obs: Optional[ndarray[bool, 1]] = None):

    return pp.scale_dense(x, zero_center, max_value, mask_obs)

def scale_sparse(csr_data: ndarray[float, 1], 
                 csr_indices: ndarray[int, 1], 
                 csr_indptr: ndarray[int, 1], 
                 n_obs: int, 
                 n_vars: int, 
                 max_value: float,
                 mask_obs: Optional[ndarray[bool, 1]] = None
                 ) -> Tuple[Tuple[ndarray[float, 1], ndarray[int, 1], ndarray[int, 1], Tuple[int, int]], ndarray[float, 1], ndarray[float, 1]]:
    # sparse matrix kernel: take x as values, indices, indptr. We just need to scale the values
    # returns the data rows from the CSRMatrix so that python can take them and rebuild its own csr matrix if needed
    x_csr = CSRMatrix(csr_data, csr_indices, csr_indptr, (n_obs, n_vars))
    x_csr, mean, std = pp.scale_sparse(x_csr, max_value, mask_obs)
    # extract values from x so that python can do stuff with them if needed
    return (x_csr.data, x_csr.indices, x_csr.indptr, x_csr.shape), mean, std

def highly_variable_genes_seurat_dense(x, n_top_genes: int):
    return pp.highly_variable_genes_seurat_dense(x, n_top_genes)

def regress_out(x, regressors):
    return pp.regress_out(x, regressors)

# --- Neighbors Wrappers ---
def neighbors(x, n_neighbors: int, kernel: str = "auto"):
    return nb.neighbors(x, n_neighbors, kernel)

# --- Tools Wrappers ---
def leiden(adata):
    # Pass through args as needed, or simplifed
    tl.leiden(adata)

def umap(adata,
        min_dist: float = 0.5,
        spread: float = 1.0,
        n_components: int = 2,
        maxiter: Optional[int] = None,
        alpha: float = 1.0,
        gamma: float = 1.0,
        negative_sample_rate: int = 5,
        init_pos: Optional[str] = "spectral",
        random_state: int = 0,
        a: Optional[float] = None,
        b: Optional[float] = None,
        key_added: Optional[str] = None,
        neighbors_key: str = "neighbors",):
    """
    pass through to tools.umap
    convert X: ndarray argument into CSRMatrix
    """
    tl.umap(adata,
            min_dist=min_dist,
            spread=spread,
            n_components=n_components,
            maxiter=maxiter,
            alpha=alpha,
            gamma=gamma,
            negative_sample_rate=negative_sample_rate,
            init_pos=init_pos,
            random_state=random_state,
            a=a,
            b=b,
            key_added=key_added,
            neighbors_key=neighbors_key)
def rank_genes_groups_dispatcher(X, groups_masks, method, ireference: int= -1):
    # handle type conversion of ireference from pyobj to codon int
    # very straightforward pyobj -> Optional[int], remember this for later
    iref: Optional[int] = None
    # unambiguous ireference -1 = None
    if ireference >= 0:
        iref = ireference
    return tl.rank_genes_groups_dispatcher(X, groups_masks, method, iref)