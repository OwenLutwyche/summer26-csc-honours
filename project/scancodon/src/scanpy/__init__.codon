def scale_dense(x, zero_center: bool, max_value: Optional[float] = None, mask_obs: Optional[ndarray[bool, 1]] = None):

    return pp.scale_dense(x, zero_center, max_value, mask_obs)

def scale_sparse(csr_data: ndarray[float, 1], 
                 csr_indices: ndarray[int, 1], 
                 csr_indptr: ndarray[int, 1], 
                 n_obs: int, 
                 n_vars: int, 
                 max_value: float,
                 mask_obs: Optional[ndarray[bool, 1]] = None
                 ) -> Tuple[Tuple[ndarray[float, 1], ndarray[int, 1], ndarray[int, 1], Tuple[int, int]], ndarray[float, 1], ndarray[float, 1]]:
    # sparse matrix kernel: take x as values, indices, indptr. We just need to scale the values
    # returns the data rows from the CSRMatrix so that python can take them and rebuild its own csr matrix if needed
    x_csr = CSRMatrix(csr_data, csr_indices, csr_indptr, (n_obs, n_vars))
    x_csr, mean, std = pp.scale_sparse(x_csr, max_value, mask_obs)
    # extract values from x so that python can do stuff with them if needed
    return (x_csr.data, x_csr.indices, x_csr.indptr, x_csr.shape), mean, std

def highly_variable_genes_seurat_dense(x, n_top_genes: int):
    return pp.highly_variable_genes_seurat_dense(x, n_top_genes)

def highly_variable_genes_seurat_sparse(data: ndarray[float, 1], 
                                        indices: ndarray[int, 1], 
                                        indptr: ndarray[int, 1], 
                                        n_obs: int, 
                                        n_vars: int, 
                                        n_top_genes: int):
    x_csr = CSRMatrix(data, indices, indptr, (n_obs, n_vars))
    return pp.highly_variable_genes_seurat_sparse(x_log=x_csr, n_top_genes=n_top_genes)

def regress_out(x, regressors):
    return pp.regress_out(x, regressors)

# --- Neighbors Wrappers ---
def neighbors_dense(x, n_neighbors: int, method: str = "umap", kernel: str = "auto"):

    indices_int, distances, connectivities = nb.neighbors_dense(x, n_neighbors, method, kernel)

    # CSRMatrix has no attribute to_py, so we disassemble and return the arrays instead
    return indices_int, distances, (connectivities.data, connectivities.indices, connectivities.indptr, connectivities.shape)

def neighbors_sparse(    
    data: ndarray[float, 1],
    indices: ndarray[int, 1],
    indptr: ndarray[int, 1],
    n_obs: int,
    n_vars: int,
    n_neighbors: int, 
    method: str = "umap",
    kernel: str = "auto"):
    X = CSRMatrix(data, indices, indptr, (n_obs, n_vars))
    indices_int, distances, connectivities = nb.neighbors_sparse(X, n_neighbors, method, kernel)
    return indices_int, distances, (connectivities.data, connectivities.indices, connectivities.indptr, connectivities.shape)

# --- Tools Wrappers ---
def leiden(
    dist_data: ndarray[float, 1],
    dist_indices: ndarray[int, 1],
    dist_indptr: ndarray[int, 1],
    n_obs: int,
    resolution: float,
    beta: float,
    n_iterations: int,
    random_state: int
) -> ndarray[int, 1]:
    
    # construct our CSRMatrix
    graph = CSRMatrix(dist_data, dist_indices, dist_indptr, (n_obs, n_obs))
    
    # handoff to the real Leiden
    final_labels = tl.leiden(
        graph, 
        resolution=resolution, 
        beta=beta, 
        n_iterations=n_iterations, 
        random_state=random_state
    )
    
    return final_labels


def umap(
    conn_data: ndarray[float, 1],
    conn_indices: ndarray[int, 1],
    conn_indptr: ndarray[int, 1],
    n_obs: int,
    n_vars: int,
    n_components: int,
    n_epochs: int,
    alpha: float,
    min_dist: float,
    spread: float,
    gamma: float,
    negative_sample_rate: int,
    random_state: int,
    init_pos: Optional[str],
    init_coords: Optional[ndarray[float, 2]],
) -> ndarray[float32, 2]:
    '''
    pass through to tools.umap
    construct connectivities: CSRMatrix out of conn_ arrays passed from python wrapper
    compute init_arr from init_coords
    '''
    connectivities = CSRMatrix(conn_data, conn_indices, conn_indptr, (n_obs, n_vars))

    init_arr: Optional[ndarray[float32, 2]] = None
    if init_coords is not None:
        n_obs_init = int(init_coords.shape[0])
        n_comp_init = int(init_coords.shape[1])
        tmp: ndarray[float32, 2] = np.zeros((n_obs_init, n_comp_init), dtype=float32)
        for i in range(n_obs_init):
            for j in range(n_comp_init):
                tmp[i, j] = float32(init_coords[i, j])
        init_arr = tmp

    return tl.umap(
        connectivities,
        n_components,
        n_epochs,
        alpha,
        min_dist,
        spread,
        gamma,
        negative_sample_rate,
        random_state,
        init_pos,
        init_arr,
    )

def diffmap(
    graph_data: ndarray[float, 1],
    graph_indices:ndarray[int, 1],
    graph_indptr:ndarray[int, 1],
    n_obs: int,
    n_vars: int,
    n_comps: int,
    random_state: int
    ) -> Tuple[ndarray[float, 1], ndarray[float, 2]]:
    # receives parts of CSRMatrix and builds it, everything else has _from_py
    graph = CSRMatrix(graph_data, graph_indices, graph_indptr, (n_obs, n_vars))

    return tl.diffmap(graph, n_comps, random_state)

def tsne(
    dist_data: ndarray[float, 1],
    dist_indices: ndarray[int, 1],
    dist_indptr: ndarray[int, 1],
    n_obs: int,
    n_vars: int,
    X_init: ndarray[float, 2],
    perplexity: float,
    random_state: int
    ) -> Tuple[ndarray[float, 2], float]:
    distances = CSRMatrix(dist_data, dist_indices, dist_indptr, (n_obs, n_vars))
    return tl.tsne(distances, X_init, perplexity, random_state)


def rank_genes_groups_dense(X: ndarray[float, 2], groups_masks: ndarray[bool, 2], method: str, ireference: int= -1, input_is_float32: bool = False
    ) -> List[Tuple[int, ndarray[float, 1], ndarray[float, 1], ndarray[float, 1], ndarray[float, 1]]]:
    iref: Optional[int] = None
    # unambiguous ireference -1 = None
    if ireference >= 0:
        iref = ireference
    return tl.rank_genes_groups_dense(X, groups_masks, method, iref, input_is_float32)

def rank_genes_groups_sparse(data: ndarray[float, 1], 
                             indices: ndarray[int, 1], 
                             indptr: ndarray[int, 1], 
                             n_obs: int,
                             n_vars: int,
                             groups_masks: ndarray[bool, 2], 
                             method: str, 
                             ireference: int = -1
    ) -> List[Tuple[int, ndarray[float, 1], ndarray[float, 1], ndarray[float, 1], ndarray[float, 1]]]:
    X = CSRMatrix(data, indices, indptr, (n_obs, n_vars))
    return tl.rank_genes_groups_sparse(X, groups_masks, method, ireference)

def benchmark_bridge_anndata(adata: pyobj) -> float:
    """TEST 1: Dynamic PyObj (Maximum Bridge Tax)"""
    print("[BENCHMARK] Codon received raw AnnData. Densifying and looping via PyObj interpreter...")
    X_py = adata.X
    
    # Safely convert to a dense array if it's sparse
    if hasattr(X_py, "toarray"):
        X_py = X_py.toarray()
        
    # Use .shape instead of len() to avoid SciPy's sparse length ambiguity error
    n_rows = X_py.shape[0]
    n_cols = X_py.shape[1]
    total_var = 0.0
    
    # Iterate using 2D coordinate indexing
    for j in range(n_cols):
        col_sum = 0.0
        col_sq_sum = 0.0
        for i in range(n_rows):
            val = float(X_py[i, j])
            col_sum += val
            col_sq_sum += val * val
        mean = col_sum / n_rows
        total_var += (col_sq_sum / n_rows) - (mean * mean)
    return total_var

def benchmark_bridge_ndarray(x: ndarray[float, 2]) -> float:
    """TEST 2: Dense ndarray (Native Memory, but O(N*M) complexity)"""
    n_rows = x.shape[0]
    n_cols = x.shape[1]
    print(f"[BENCHMARK] Codon received Native ndarray. Shape: {n_rows}, {n_cols}")
    total_var = 0.0
    
    for j in range(n_cols):
        col_sum = 0.0
        col_sq_sum = 0.0
        for i in range(n_rows):
            val = x[i, j]
            col_sum += val
            col_sq_sum += val * val
        mean = col_sum / n_rows
        total_var += (col_sq_sum / n_rows) - (mean * mean)
    return total_var

def benchmark_bridge_csr(
    data: ndarray[float, 1],
    indices: ndarray[int, 1],
    indptr: ndarray[int, 1],
    n_rows: int,
    n_cols: int
) -> float:
    """TEST 3: Sparse CSR (Zero-copy marshalling, O(NNZ) complexity)"""
    print(f"[BENCHMARK] Codon received CSR components natively. Shape: {n_rows}, {n_cols}")
    
    # Pre-allocate sum arrays
    col_sums = np.zeros(n_cols, dtype=float)
    col_sq_sums = np.zeros(n_cols, dtype=float)
    
    # Iterate ONLY over non-zero elements
    nnz = len(data)
    for k in range(nnz):
        c = indices[k]
        v = data[k]
        col_sums[c] += v
        col_sq_sums[c] += v * v
        
    total_var = 0.0
    n = float(n_rows)
    for j in range(n_cols):
        mean = col_sums[j] / n
        total_var += (col_sq_sums[j] / n) - (mean * mean)
        
    return total_var

# ==========================================
# TEST 1: Iterative Column Statistics (Native/Sparse Wins)
# ==========================================
def benchmark_var_pyobj(adata: pyobj) -> float:
    X_py = adata.X
    if hasattr(X_py, "toarray"):
        X_py = X_py.toarray()
    n_rows = X_py.shape[0]
    n_cols = X_py.shape[1]
    total_var = 0.0
    for j in range(n_cols):
        col_sum = 0.0
        col_sq_sum = 0.0
        for i in range(n_rows):
            val = float(X_py[i, j])
            col_sum += val
            col_sq_sum += val * val
        mean = col_sum / n_rows
        total_var += (col_sq_sum / n_rows) - (mean * mean)
    return total_var

def benchmark_var_ndarray(x: ndarray[float, 2]) -> float:
    n_rows = x.shape[0]
    n_cols = x.shape[1]
    total_var = 0.0
    for j in range(n_cols):
        col_sum = 0.0
        col_sq_sum = 0.0
        for i in range(n_rows):
            val = x[i, j]
            col_sum += val
            col_sq_sum += val * val
        mean = col_sum / n_rows
        total_var += (col_sq_sum / n_rows) - (mean * mean)
    return total_var

def benchmark_var_csr(
    data: ndarray[float, 1],
    indices: ndarray[int, 1],
    indptr: ndarray[int, 1],
    n_rows: int,
    n_cols: int
) -> float:
    col_sums = np.zeros(n_cols, dtype=float)
    col_sq_sums = np.zeros(n_cols, dtype=float)
    nnz = len(data)
    for k in range(nnz):
        c = indices[k]
        v = data[k]
        col_sums[c] += v
        col_sq_sums[c] += v * v
    total_var = 0.0
    n = float(n_rows)
    for j in range(n_cols):
        mean = col_sums[j] / n
        total_var += (col_sq_sums[j] / n) - (mean * mean)
    return total_var


# ==========================================
# TEST 2: One-off Matrix Multiplication (X.T @ X)
# Shows why a naive Dense ndarray loop loses to PyObj leveraging C-BLAS vectorization
# ==========================================
def benchmark_matmul_pyobj(x: pyobj) -> pyobj:
    return x.T @ x

def benchmark_matmul_ndarray(x: ndarray[float, 2]) -> ndarray[float, 2]:
    return x.T @ x

def benchmark_matmul_csr(
    data: ndarray[float, 1],
    indices: ndarray[int, 1],
    indptr: ndarray[int, 1],
    n_rows: int,
    n_cols: int
) -> ndarray[float, 2]:
    x: CSRMatrix = CSRMatrix(data, indices, indptr, (n_rows, n_cols))
    result = x.T @ x
    return result.to_dense()


# ==========================================
# TEST 3: Dense Matrix Offset Addition (x + 1.0)
# Shows why Sparse CSR is WORSE than Dense ndarray when operations destroy sparsity
# ==========================================
def benchmark_add_pyobj(x: pyobj) -> pyobj:
    return x + 1.0

def benchmark_add_ndarray(x: ndarray[float, 2]) -> ndarray[float, 2]:
    # Highly SIMD-vectorized contiguous memory addition
    return x + 1.0

def benchmark_add_csr(
    data: ndarray[float, 1],
    indices: ndarray[int, 1],
    indptr: ndarray[int, 1],
    n_rows: int,
    n_cols: int
) -> Tuple[ndarray[float, 1], ndarray[int, 1], ndarray[int, 1]]:
    # Adding a scalar (1.0) to a sparse matrix destroys its sparsity (every zero becomes 1.0).
    # CSR must reallocate data for every single zero element, causing massive overhead.
    total_elements = n_rows * n_cols
    new_data = np.zeros(total_elements, dtype=float)
    new_indices = np.zeros(total_elements, dtype=int)
    new_indptr = np.zeros(n_rows + 1, dtype=int)
    
    curr = 0
    for r in range(n_rows):
        row_start = indptr[r]
        row_end = indptr[r+1]
        col_ptr = 0
        for c in range(n_cols):
            # Check if sparse matrix had a value here
            val = 0.0
            if col_ptr < (row_end - row_start) and indices[row_start + col_ptr] == c:
                val = data[row_start + col_ptr]
                col_ptr += 1
            # Add scalar offset
            new_data[curr] = val + 1.0
            new_indices[curr] = c
            curr += 1
        new_indptr[r+1] = curr
    return new_data[:curr], new_indices[:curr], new_indptr