def normalize_total_sparse(
    data: ndarray[float, 1], 
    indices: ndarray[int, 1], 
    indptr: ndarray[int, 1], 
    n_rows: int,
    n_cols: int,
    target_sum: float
) -> ndarray[float, 1]:
    return pp.normalize_total_sparse(data, indices, indptr, n_rows, n_cols, target_sum)

