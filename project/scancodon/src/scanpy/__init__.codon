# src/scanpy/__init__.codon
# Top-level package entry point
# We wrap the submodule functions to force the compiler to export them.

from typing import Optional, Tuple, List

import preprocessing as pp
import neighbors as nb
import tools as tl
import numpy as np
import math
from numpy import ndarray
from ._csr import CSRMatrix, from_dense

# --- Preprocessing Wrappers ---
def log1p_dense(x, base: Optional[float] = None):
    return pp.log1p_dense(x, base)

def calculate_qc_metrics(
    data: ndarray[float, 1],
    indices: ndarray[int, 1],
    indptr: ndarray[int, 1],
    n_rows: int,
    n_cols: int,
    qc_masks_arr: ndarray[bool, 2],
    percent_top_arr: ndarray[int, 1],
    log1p_metrics: bool,
) -> Tuple[
    Tuple[
        ndarray[int, 1],   # nnz
        ndarray[float, 1], # log1p_nnz
        ndarray[float, 1], # totals
        ndarray[float, 1], # log1p_totals
        ndarray[float, 2], # props
        ndarray[float, 2], # qc_totals
        ndarray[float, 2], # log1p_qc_totals
        ndarray[float, 2]  # qc_pcts
    ],
    Tuple[
        ndarray[int, 1],   # nnz
        ndarray[float, 1], # means
        ndarray[float, 1], # log1p_means
        ndarray[float, 1], # dropout
        ndarray[float, 1], # totals
        ndarray[float, 1], # log1p_totals
    ]
]:
    # Extract shape as concrete ints
    csr_shape: Tuple[int, int] = (n_rows, n_cols)

    # Construct CSRMatrix from the typed flat arrays
    X_csr = CSRMatrix(data, indices, indptr, csr_shape)

    # Convert 1D numpy array to List[int]
    percent_top_list: List[int] = []
    for i in range(percent_top_arr.shape[0]):
        percent_top_list.append(int(percent_top_arr[i]))

    # Unpack 2D boolean array columns into List[ndarray[bool, 1]]
    qc_masks_list: List[ndarray[bool, 1]] = []
    n_qc = qc_masks_arr.shape[1]
    for j in range(n_qc):
        qc_masks_list.append(qc_masks_arr[:, j])

    return pp.calculate_qc_metrics(
        X_csr,
        qc_masks_list,
        percent_top=percent_top_list,
        log1p_metrics=log1p_metrics,
    )

def log1p_sparse(
    data: ndarray[float, 1], 
    base: Optional[float] = None
    ) ->ndarray[float, 1]:
    # If this is used as an in-place operation we should return the modified input data structure
    # for consistency we'll want to return the 
    return pp.log1p_sparse(data, base)

def normalize_total_dense(x, target_sum: float, 
                          exclude_highly_expressed: bool, 
                          max_fraction: float):
    return pp.normalize_total_dense(x, target_sum, exclude_highly_expressed, max_fraction)

def normalize_total_sparse(
    data: ndarray[float, 1], 
    indices: ndarray[int, 1], 
    indptr: ndarray[int, 1], 
    n_rows: int,
    n_cols: int,
    target_sum: float
) -> ndarray[float, 1]:
    X = CSRMatrix(data, indices, indptr, (n_rows, n_cols))
    X_processed, norm_factor = pp.normalize_total_sparse(X, target_sum)
    return norm_factor

def filter_cells_dense(
    x,
    min_counts: Optional[int] = None,
    min_genes: Optional[int] = None,
    max_counts: Optional[int] = None,
    max_genes: Optional[int] = None,
):
    
    return pp.filter_cells_dense(x, min_counts, min_genes, max_counts, max_genes)

def filter_cells_sparse(
    data: ndarray[float, 1], 
    indptr: ndarray[int, 1], 
    n_rows: int,
    min_counts: Optional[int] = None, 
    min_genes: Optional[int] = None, 
    max_counts: Optional[int] = None, 
    max_genes: Optional[int] = None
    ) -> Tuple[ndarray[bool, 1], ndarray[float, 1]]:
    return pp.filter_cells_sparse(data, indptr, n_rows, min_counts, min_genes, max_counts, max_genes)


def scrublet(
    data: ndarray[float, 1],
    indices: ndarray[int, 1],
    indptr: ndarray[int, 1],
    n_rows: int,
    n_cols: int,
    sim_doublet_ratio: float,
    expected_doublet_rate: float,
    stdev_doublet_rate: float,
    random_state: int
    ) -> Tuple[Optional[ndarray[float, 1]], ndarray[bool, 1]]:
    X = CSRMatrix(data, indices, indptr, (n_rows, n_cols))
    result = pp.scrublet(X, 
                         sim_doublet_ratio, 
                         expected_doublet_rate, 
                         stdev_doublet_rate, 
                         random_state)

    return result


def pca(
    X_data: ndarray[float, 1],
    X_indices: ndarray[int, 1],
    X_indptr: ndarray[int, 1],
    n_obs: int,
    n_vars: int,
    n_comps: int = 50,
    zero_center: bool = True,
    standardize: bool = False,
) -> Tuple[ndarray[float, 2], ndarray[float, 2], ndarray[float, 1], ndarray[float, 1]]:
    # build CSRMatrix like usual and send to pca
    X = CSRMatrix(X_data, X_indices, X_indptr, (n_obs, n_vars))

    # use the randomized svd calculation if n_vars is larger than 10,000
    use_randomized_svd: bool = n_vars > 10000 or n_obs > 10000
    return pp.pca(
        X,
        n_comps,
        zero_center,
        standardize,
        use_randomized_svd
    )

def filter_genes_dense(
    x,
    min_counts: Optional[int] = None,
    min_cells: Optional[int] = None,
    max_counts: Optional[int] = None,
    max_cells: Optional[int] = None,
):
    return pp.filter_genes_dense(x, min_counts, min_cells, max_counts, max_cells)

def filter_genes_sparse(
    data: ndarray[float, 1], 
    indices: ndarray[int, 1], 
    n_cols: int,
    min_counts: Optional[int] = None, 
    min_cells: Optional[int] = None, 
    max_counts: Optional[int] = None, 
    max_cells: Optional[int] = None
    ) -> Tuple[ndarray[bool, 1], ndarray[float, 1]]:
