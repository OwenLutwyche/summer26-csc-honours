# src/scanpy/__init__.codon
# Top-level package entry point
# We wrap the submodule functions to force the compiler to export them.

from typing import Optional

import preprocessing as pp
import neighbors as nb
import tools as tl
import numpy as np
import math
from numpy import ndarray
from typing import Tuple
from ._csr import CSRMatrix, from_dense

# --- Preprocessing Wrappers ---
def log1p(x, base: Optional[float] = None):
    return pp.log1p(x, base)

def calculate_qc_metrics(
    data: ndarray[float, 1],
    indices: ndarray[int, 1],
    indptr: ndarray[int, 1],
    shape: pyobj,
    qc_masks: pyobj,
    percent_top: pyobj,
    log1p_metrics: bool,
    ) -> Tuple[
    # obs_metrics
    Tuple[
        ndarray[int, 1],   # nnz
        ndarray[float, 1], # log1p_nnz
        ndarray[float, 1], # totals
        ndarray[float, 1], # log1p_totals
        ndarray[float, 2], # props (n_rows, len(percent_top))
        ndarray[float, 2], # qc_totals (n_rows, n_qc)
        ndarray[float, 2], # log1p_qc_totals (n_rows, n_qc)
        ndarray[float, 2]  # qc_pcts (n_rows, n_qc)
    ],
    # var_metrics
    Tuple[
        ndarray[int, 1],   # nnz
        ndarray[float, 1], # means
        ndarray[float, 1], # log1p_means
        ndarray[float, 1], # dropout
        ndarray[float, 1], # totals
        ndarray[float, 1], # log1p_totals
    ]
    ]:
    # Extract shape as concrete ints — Python tuple arrives as pyobj
    n_rows: int = int(shape[0])
    n_cols: int = int(shape[1])
    csr_shape: Tuple[int, int] = (n_rows, n_cols)

    # Construct CSRMatrix from the typed flat arrays
    X_csr = CSRMatrix(data, indices, indptr, csr_shape)

    # Convert percent_top pyobj to List[int]
    percent_top_list: List[int] = [int(x) for x in percent_top]

    return pp.calculate_qc_metrics(
        X_csr,
        qc_masks,
        percent_top=percent_top_list,
        log1p_metrics=log1p_metrics,
    )



def log1p_sparse(
    data: ndarray[float, 1], 
    indices: ndarray[int, 1], 
    indptr: ndarray[int, 1], 
    n_rows: int,             
    n_cols: int,             
    base: float
):
    # the log1p operation on a sparse matrix is literally just iterating the value array
    has_base: bool = base > 0.0
    log_base: float = math.log(base) if has_base else 1.0
            # for i in range(len(self.data)):
            # val = math.log1p(self.data[i])
            # if has_base:
            #     val /= log_base
            # self.data[i] = val
    for i in range(len(data)):
        val = math.log1p(data[i])
        if has_base:
            val /= log_base
        data[i] = val
    return data # done in place

    shape: Tuple[int, int] = (n_rows, n_cols)
    X_csr = CSRMatrix(data, indices, indptr, shape)
    X_csr.log1p_inplace(base)

def normalize_total_dense(x, target_sum: float, 
                          exclude_highly_expressed: bool, 
                          max_fraction: float):
