# --- EXPORTED DISPATCHER (The new, simple entry point) ---
def rank_genes_groups_dispatcher(
    X_raw: pyobj,
    groups_masks: ndarray[bool, 2],
    method: str,
    ireference: Optional[int],
):
    """
    Main dispatcher kernel for rank_genes_groups.
    Calls pure math kernels.
    """
    # Perform explicit conversion at the boundary
    # This invokes the conversion to native memory layout once
    X: ndarray[float, 2] = np.array(_ensure_dense(X_raw), dtype=float)

    if method in ("t-test", "t-test_overestim_var"):
        print(f"[INFO] Running t-test for rank_genes_groups, ireference: {ireference}")
        return _t_test(X, groups_masks, None, ireference)
    elif method == "wilcoxon":
        print("[INFO] Running Wilcoxon test for rank_genes_groups")
        return _wilcoxon(X, groups_masks, None, ireference)
    else:
        # Fallback for unsupported methods
        empty: List[Tuple[int, ndarray[float, 1], ndarray[float, 1]]] = []
        return empty
