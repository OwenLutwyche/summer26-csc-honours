import numpy as np
from numpy import ndarray
from typing import Optional, List, Tuple
import math

from math import exp, log, lgamma
from .._csr import CSRMatrix

EPS = 3.0e-14 
FPMIN = 1.0e-300 
MAX_ITER = 10000 

def _betacf(a: float, b: float, x: float) -> float:
    qab = a + b
    qap = a + 1.0
    qam = a - 1.0

    c = 1.0
    d = 1.0 - qab * x / qap
    if abs(d) < FPMIN:
        d = FPMIN
    d = 1.0 / d
    h = d

    for m in range(1, MAX_ITER + 1):
        m2 = 2 * m
        aa = m * (b - m) * x
        aa /= (qam + m2) * (a + m2)

        d = 1.0 + aa * d
        if abs(d) < FPMIN:
            d = FPMIN

        c = 1.0 + aa / c
        if abs(c) < FPMIN:
            c = FPMIN

        d = 1.0 / d
        h *= d * c

        aa = -(a + m) * (qab + m) * x
        aa /= (a + m2) * (qap + m2)

        d = 1.0 + aa * d
        if abs(d) < FPMIN:
            d = FPMIN

        c = 1.0 + aa / c
        if abs(c) < FPMIN:
            c = FPMIN

        d = 1.0 / d
        delta = d * c
        h *= delta
        
        if abs(delta - 1.0) < EPS:
            break
    return h


def betainc(a: float, b: float, x: float) -> float:
    if x <= 0.0:
        return 0.0
    if x >= 1.0:
        return 1.0
    ln_beta = lgamma(a) + lgamma(b) - lgamma(a + b)
    bt = exp(
        a * log(x)
        + b * log(1.0 - x)
        - ln_beta
    )
    if x < (a + 1.0) / (a + b + 2.0):
        return bt * _betacf(a, b, x) / a
    else:
        return 1.0 - bt * _betacf(b, a, 1.0 - x) / b

def t_sf(t: ndarray[float, 1], df: ndarray[float, 1]) -> ndarray[float, 1]:
    n = t.shape[0]
    result = np.zeros(n, dtype=np.float64)
    
    for i in range(n):
        t_val = t[i]
        df_val = df[i]
        
        if df_val <= 0.0:
            result[i] = 1.0
            continue
            
        denom = df_val + (t_val**2.0)
        if denom == 0.0:
            result[i] = 1.0
            continue
        x = df_val / denom
        result[i] = 0.5 * betainc(df_val / 2.0, 0.5, x)
        
    return result

def _ensure_dense(x) -> ndarray[float, 2]:
    if hasattr(x, "toarray"):
        return x.toarray()
    return x

def _nan_to_num(arr: ndarray[float, 1], nan_val: float) -> ndarray[float, 1]:
    for i in range(arr.shape[0]):
        v = arr[i]
        if math.isnan(v):
            arr[i] = nan_val
        elif math.isinf(v):
            arr[i] = 1.7976931348623157e+308 if v > 0.0 else -1.7976931348623157e+308
    return arr

def clamp_to_zero(arr: ndarray[float, 1], clamp_at: float) -> ndarray[float, 1]:
    for i in range(arr.shape[0]):
        v = arr[i]
        if v < clamp_at:
            arr[i] = 0.0
    return arr

def _norm_sf(z: float) -> float:
    return 0.5 * math.erfc(z / math.sqrt(2.0))

def _rankdata(col: ndarray[float, 1]) -> ndarray[float, 1]:
    n = col.shape[0]
    order = np.argsort(col)
    ranks = np.zeros(n)
    i = 0
    while i < n:
        j = i + 1
        while j < n and col[order[j]] == col[order[i]]:
            j += 1
        avg_rank = (i + j + 1) / 2.0 
        for k in range(i, j):
            ranks[order[k]] = avg_rank
        i = j
    return ranks

def _correct_pvalues_bh(pvals: ndarray[float, 1]) -> ndarray[float, 1]:
    n = pvals.shape[0]
    if n == 0:
        return np.zeros(0, dtype=float)

    sorted_idx = np.argsort(pvals)
    adjusted = np.zeros(n, dtype=float)
    prev = 1.0

    for i in range(n - 1, -1, -1):
        idx = sorted_idx[i]
        pval = pvals[idx]
        
        adj = pval * float(n) / float(i + 1)
        
        if adj > prev:
            adj = prev
        elif adj > 1.0:
            adj = 1.0
        
        adjusted[idx] = adj
        prev = adj

    return adjusted


def _t_test(
    X,
    groups_masks: ndarray[bool, 2],
    groups_order,
    ireference: Optional[int],
):
    """
    Perform Welch's t-test for each gene between groups.
    Native Codon implementation for speed.
    """
    n_groups = int(groups_masks.shape[0])
    n_cells = int(groups_masks.shape[1])
    n_genes = int(X.shape[1])
    
    # Densify if sparse
    X = _ensure_dense(X)
    # Cast groups_masks to native bool array so ndarray boolean indexing works
    groups_masks_native: ndarray[bool, 2] = np.array(groups_masks, dtype=bool)
    
    # precompute various things
    total_sum = np.sum(X, axis=0)
    X_sq = X ** 2
    total_sum_sq = np.sum(X_sq, axis=0)
    total_n = float(n_cells)

    # Pre-allocate accumulators outside the loop
    sum_vals = np.zeros((n_groups, n_genes))
    sum_sq_vals = np.zeros((n_groups, n_genes))
    ns = np.zeros(n_groups) # number of samples for each group
    # Compute means and variances for each group
    means = np.zeros((n_groups, n_genes))
    vars_ = np.zeros((n_groups, n_genes))
    
    # Single pass accumulation (Avoids X[mask, :] copying)
    # This loop is cache-friendly for row-major matrices
    for r in range(n_cells):
        for g in range(n_groups):
            if groups_masks_native[g, r]:
                # compute sum and sum square all together
                val = X[r]
                sum_vals[g] += val
                sum_sq_vals[g] += val * val
                ns[g] += 1
    # iterate again, computing means if applicable
    for g in range(n_groups):
        if ns[g] > 1:
            means[g] = sum_vals[g] / ns[g]
            
            # --- apply Bessel's Correction (ddof=1) with Cancellation Protection ---
            var_pop = np.maximum((sum_sq_vals[g] / ns[g]) - (means[g]**2), 0.0)
            
            for i in range(n_genes):
                expected_sq = means[g][i] ** 2
                actual_sq = sum_sq_vals[g][i] / ns[g]
                if abs(actual_sq - expected_sq) < 1e-10 * (abs(expected_sq) + 1.0):
                    var_pop[i] = 0.0

            vars_[g] = var_pop * (ns[g] / (ns[g] - 1.0))
            
        elif ns[g] == 1:
            means[g] = sum_vals[g] / ns[g]
            vars_[g] = 0.0

    results: List[Tuple[int, ndarray[float, 1], ndarray[float, 1], ndarray[float, 1], ndarray[float, 1]]] = []
    

    for group_idx in range(n_groups):

        if ireference is not None and group_idx == ireference:
            continue
        
        mean1 = means[group_idx]
        var1 = vars_[group_idx]
        n1 = ns[group_idx]
        
        if ireference is not None:
            iref_idx = int(ireference)
            mean2 = means[iref_idx]
            var2 = vars_[iref_idx]
            n2 = ns[iref_idx]
        else:
            # Compare to rest of the dataset
            n2 = total_n - n1
            mean2 = (total_sum - sum_vals[group_idx]) / n2
            
            # --- FIX: Apply Bessel's Correction (ddof=1) with Cancellation Protection ---
            var2_pop = np.maximum(((total_sum_sq - sum_sq_vals[group_idx]) / n2) - (mean2**2), 0.0)
            
            for i in range(n_genes):
                expected_sq = mean2[i] ** 2
                actual_sq = (total_sum_sq[i] - sum_sq_vals[group_idx][i]) / n2
                if abs(actual_sq - expected_sq) < 1e-10 * (abs(expected_sq) + 1.0):
                    var2_pop[i] = 0.0

            var2 = var2_pop * (n2 / (n2 - 1.0))
        
        
        # Welch's t-test
        se1 = var1 / n1
        se2 = var2 / n2
        se_total = np.sqrt(np.maximum(se1 + se2, 0.0))
        
        # --- FIX: Mask out zero-variance genes completely before division ---
        zero_var_mask = se_total < 1e-10
        
        
        # Prevent division by zero by temporarily substituting 1.0 where variance is zero
        safe_se_total = np.where(zero_var_mask, 1.0, se_total)

        scores = (mean1 - mean2) / safe_se_total
        
        # Degrees of freedom (Welch-Satterthwaite)
        df_num = (se1 + se2) ** 2
        df_den = (se1 ** 2) / (n1 - 1) + (se2 ** 2) / (n2 - 1)
        df = df_num / df_den
        
        # Two-tailed p-value
        pvals = 2 * t_sf(np.abs(scores), df)
        
        # --- FIX: Force zero scores and p-value = 1.0 for flatline genes ---
        scores[zero_var_mask] = 0.0
        pvals[zero_var_mask] = 1.0
        df[zero_var_mask] = 1.0
        
        scores = _nan_to_num(scores, 0.0)
        pvals = _nan_to_num(pvals, 1.0)
        
        
        pvals_adj = _correct_pvalues_bh(pvals)
        
        lfc = np.zeros(n_genes, dtype=float)
        for i in range(n_genes):
            
            numerator = math.expm1(mean1[i]) + 1e-9
            denominator = math.expm1(mean2[i]) + 1e-9
            ratio = numerator / denominator
            
            if ratio <= 0:
                # fallback: NaN to mirror scanpy
                lfc[i] = np.nan
            else:
                lfc[i] = math.log2(ratio)
        
        # Return all 5 arrays
        results.append((group_idx, scores, pvals, pvals_adj, lfc))
    

    
    return results


def _wilcoxon(X, groups_masks: ndarray[bool, 2], groups_order, ireference: Optional[int] = None):
    """
    Perform Wilcoxon rank-sum test for each gene.
    Uses normal approximation for large samples.
    """
    n_groups = int(groups_masks.shape[0])
    n_genes = int(X.shape[1])
    
    X = _ensure_dense(X)
    groups_masks_native: ndarray[bool, 2] = np.array(groups_masks, dtype=bool)
    
    results: List[Tuple[int, ndarray[float, 1], ndarray[float, 1], ndarray[float, 1], ndarray[float, 1]]] = []
    
    for group_idx in range(n_groups):
        if ireference is not None and group_idx == ireference:
            continue
        
        mask1 = groups_masks_native[group_idx]
        if ireference is not None:
            iref_idx = int(ireference)
            mask2 = groups_masks_native[iref_idx]
        else:
            mask2 = ~mask1
        
        n1 = int(np.count_nonzero(mask1))
        n2 = int(np.count_nonzero(mask2))
        
        scores = np.zeros(n_genes)
        pvals = np.zeros(n_genes)
        lfc = np.zeros(n_genes)
        
        # Rank all data and compute rank sums
        X_combined = np.vstack([X[mask1, :], X[mask2, :]])
        
        for j in range(n_genes):
            col = X_combined[:, j]

            # compute log fold change
            mean1 = float(np.sum(col[:n1])) / float(n1) if n1 > 0 else 0.0
            mean2 = float(np.sum(col[n1:])) / float(n2) if n2 > 0 else 0.0
            lfc[j] = math.log2((mean1 + 1e-9) / (mean2 + 1e-9))

            ranks = _rankdata(col)
            
            # Rank sum for group 1
            R1 = ranks[:n1].sum()
            
            # Normal approximation
            mu = n1 * (n1 + n2 + 1) / 2
            
            # Tie correction
            unique = np.unique(col)
            counts = np.array([np.sum(col == u) for u in unique]) # split into two lines
            tie_term = np.sum(counts ** 3 - counts)
            sigma = np.sqrt(n1 * n2 * ((n1 + n2 + 1) / 12 - tie_term / (12 * (n1 + n2) * (n1 + n2 - 1))))
            
            if sigma > 0:
                z = (R1 - mu) / sigma
                scores[j] = z
                pvals[j] = 2 * _norm_sf(math.fabs(z))
            else:
                scores[j] = 0
                pvals[j] = 1

        # FDR correction
        pvals_adj = _correct_pvalues_bh(pvals)
        results.append((group_idx, scores, pvals, pvals_adj, lfc))
    
    return results


# ==============================================================================
# IN-FLIGHT PYTHON DIAGNOSTIC BRIDGE
# ==============================================================================
@python
def debug_bridge_ttest(
    group_idx: int,
    X_data, X_indices, X_indptr, n_obs: int, n_vars: int,
    mask1_arr, mask2_arr,
    c_m1, c_m2, c_v1, c_v2, c_df, c_scores, c_pvals, c_lfc
):
    import numpy as np
    import scipy.sparse as sp_sparse
    import scipy.stats as stats
    import warnings
    
    warnings.filterwarnings("ignore", category=RuntimeWarning)
    
    X = sp_sparse.csr_matrix((X_data, X_indices, X_indptr), shape=(n_obs, n_vars)).toarray()
    
    g1 = X[np.array(mask1_arr, dtype=bool)]
    g2 = X[np.array(mask2_arr, dtype=bool)]
    
    py_m1 = np.mean(g1, axis=0)
    py_m2 = np.mean(g2, axis=0)
    
    n1 = g1.shape[0]
    n2 = g2.shape[0]
    py_v1 = np.var(g1, axis=0, ddof=1) if n1 > 1 else np.zeros(n_vars)
    py_v2 = np.var(g2, axis=0, ddof=1) if n2 > 1 else np.zeros(n_vars)
    
    py_scores, py_pvals = stats.ttest_ind(g1, g2, axis=0, equal_var=False, nan_policy='omit')
    
    # Python reference LFC
    py_num = np.expm1(py_m1) + 1e-9
    py_den = np.expm1(py_m2) + 1e-9
    py_ratio = py_num / py_den
    py_lfc = np.where(py_ratio <= 0.0, np.nan, np.log2(py_ratio))
    
    # --- TARGETED INSPECTOR FOR DIVERGING GENES ---
    c_sc = np.array(c_scores, dtype=float)
    diffs = np.abs(c_sc - py_scores)
    bad_indices = np.where(diffs > 1.0)[0]
    
    if len(bad_indices) > 0:
        print(f"\n[PYTHON BRIDGE INSPECTOR] Group {group_idx}: Found {len(bad_indices)} genes with score diff > 1.0")
        for idx in bad_indices[:5]:
            print(f"  -> Gene Index {idx}: Codon Score={c_sc[idx]:.4f}, Scipy Score={py_scores[idx]:.4f}")
            print(f"     Mean1: Codon={c_m1[idx]:.4e}, SciPy={py_m1[idx]:.4e}")
            print(f"     Mean2: Codon={c_m2[idx]:.4e}, SciPy={py_m2[idx]:.4e}")
            print(f"     Var1:  Codon={c_v1[idx]:.4e}, SciPy={py_v1[idx]:.4e}")
            print(f"     Var2:  Codon={c_v2[idx]:.4e}, SciPy={py_v2[idx]:.4e}")
    # ----------------------------------------------


def _t_test_sparse(
    X: CSRMatrix,
    groups_masks: ndarray[bool, 2],
    ireference: Optional[int],
):
    n_groups = int(groups_masks.shape[0])
    n_cells = X.shape[0]
    n_genes = X.shape[1]
    
    groups_masks_native: ndarray[bool, 2] = np.array(groups_masks, dtype=bool)
    
    ns = np.zeros(n_groups, dtype=float)
    for r in range(n_cells):
        for g in range(n_groups):
            if groups_masks_native[g, r]:
                ns[g] += 1.0

    total_n = float(n_cells)

    sum_vals = np.zeros((n_groups, n_genes), dtype=np.float64)
    sum_vals_rest = np.zeros((n_groups, n_genes), dtype=np.float64)
    nnz_group = np.zeros((n_groups, n_genes), dtype=np.float64)
    nnz_rest = np.zeros((n_groups, n_genes), dtype=np.float64)
    
    for r in range(n_cells):
        start = X.indptr[r]
        end = X.indptr[r+1]
        in_group = np.zeros(n_groups, dtype=bool)
        for g in range(n_groups):
            if groups_masks_native[g, r]:
                in_group[g] = True
                
        for ptr in range(start, end):
            c = X.indices[ptr]
            v = X.data[ptr]
            for g in range(n_groups):
                if in_group[g]:
                    sum_vals[g, c] += v
                    nnz_group[g, c] += 1.0
                else:
                    sum_vals_rest[g, c] += v
                    nnz_rest[g, c] += 1.0

    means = np.zeros((n_groups, n_genes), dtype=np.float64)
    means_rest = np.zeros((n_groups, n_genes), dtype=np.float64)    
    for g in range(n_groups):
        if ns[g] > 0.0:
            means[g] = sum_vals[g] / ns[g]
        n2 = total_n - ns[g]
        if n2 > 0.0:
            means_rest[g] = sum_vals_rest[g] / n2

    sq_diff_group = np.zeros((n_groups, n_genes), dtype=np.float64)
    sq_diff_rest = np.zeros((n_groups, n_genes), dtype=np.float64)

    for r in range(n_cells):
        start = X.indptr[r]
        end = X.indptr[r+1]
        in_group = np.zeros(n_groups, dtype=bool)
        for g in range(n_groups):
            if groups_masks_native[g, r]:
                in_group[g] = True
                
        for ptr in range(start, end):
            c = X.indices[ptr]
            v = X.data[ptr]
            for g in range(n_groups):
                if in_group[g]:
                    diff = v - means[g, c]
                    sq_diff_group[g, c] += diff * diff
                else:
                    diff = v - means_rest[g, c]
                    sq_diff_rest[g, c] += diff * diff

    vars_ = np.zeros((n_groups, n_genes), dtype=np.float64)
    vars_rest = np.zeros((n_groups, n_genes), dtype=np.float64)
    
    for g in range(n_groups):
        n2 = total_n - ns[g]
        for c in range(n_genes):
            zero_count = ns[g] - nnz_group[g, c]
            if zero_count > 0.0:
                sq_diff_group[g, c] += zero_count * (means[g, c] ** 2)
                
            zero_count_r = n2 - nnz_rest[g, c]
            if zero_count_r > 0.0:
                sq_diff_rest[g, c] += zero_count_r * (means_rest[g, c] ** 2)
                
            # --- FIX: Explicitly floor variances at 0.0 to prevent floating-point noise ---
            if ns[g] > 1.0:
                vars_[g, c] = max(sq_diff_group[g, c] / (ns[g] - 1.0), 0.0)
            if n2 > 1.0:
                vars_rest[g, c] = max(sq_diff_rest[g, c] / (n2 - 1.0), 0.0)

    results: List[Tuple[int, ndarray[float, 1], ndarray[float, 1], ndarray[float, 1], ndarray[float, 1]]] = []
    
    for group_idx in range(n_groups):
        if ireference is not None and group_idx == ireference:
            continue
        
        mean1 = means[group_idx]
        var1 = vars_[group_idx]
        n1 = ns[group_idx]
        mask1 = groups_masks_native[group_idx]
        
        if ireference is not None:
            iref_idx = int(ireference)
            mean2 = means[iref_idx]
            var2 = vars_[iref_idx]
            n2 = ns[iref_idx]
            mask2 = groups_masks_native[iref_idx]
        else:
            mean2 = means_rest[group_idx]
            var2 = vars_rest[group_idx]
            n2 = total_n - n1
            mask2 = ~mask1
        
        se1 = var1 / n1 if n1 > 0.0 else np.zeros(n_genes, dtype=float)
        se2 = var2 / n2 if n2 > 0.0 else np.zeros(n_genes, dtype=float)
        se_total = np.sqrt(np.maximum(se1 + se2, 0.0))
        
        # zero-variance check matching scipy?
        zero_var_mask = se_total == 0.0
        safe_se_total = np.where(zero_var_mask, 1.0, se_total)

        scores = (mean1 - mean2) / safe_se_total
        
        max_se = np.maximum(np.max(se1), np.max(se2))
        k = 1.0 / np.sqrt(max_se) if max_se > 0.0 else 1.0
        
        sse1 = se1 * k
        sse2 = se2 * k
        
        df_num = (sse1 + sse2) ** 2
        df_den = np.zeros(n_genes, dtype=float)
        
        if n1 > 1.0:
            df_den += (sse1 ** 2) / (n1 - 1.0)
        if n2 > 1.0:
            df_den += (sse2 ** 2) / (n2 - 1.0)
            
        df_den = np.where(df_den < 1e-10, 1.0, df_den)
        df = df_num / df_den
        df = np.where(df <= 0.0, 1.0, df)
        
        pvals = 2.0 * t_sf(np.abs(scores), df)
        pvals = np.clip(pvals, 0.0, 1.0)
        
        scores[zero_var_mask] = math.nan
        pvals[zero_var_mask] = math.nan
        
        # --- FIX: Restore Scanpy's exact expm1-based log fold change formula ---
        lfc = np.zeros(n_genes, dtype=float)
        for i in range(n_genes):
            if zero_var_mask[i]:
                lfc[i] = math.nan
                continue
            num = math.expm1(mean1[i]) + 1e-9
            den = math.expm1(mean2[i]) + 1e-9
            ratio = num / den
            if ratio <= 0.0:
                lfc[i] = math.nan
            else:
                lfc[i] = math.log2(ratio)
        # ----------------------------------------------------------------------
        
        debug_bridge_ttest(
            group_idx,
            X.data, X.indices, X.indptr, n_cells, n_genes,
            mask1, mask2,
            mean1, mean2, var1, var2, df, scores, pvals, lfc
        )
        
        pvals_adj = _correct_pvalues_bh(pvals)
        results.append((group_idx, scores, pvals, pvals_adj, lfc))
    
    return results
def rank_genes_groups_dense(
    X: ndarray[float, 2],
    groups_masks: ndarray[bool, 2],
    method: str,
    ireference: Optional[int],
) -> List[Tuple[int, ndarray[float, 1], ndarray[float, 1], ndarray[float, 1], ndarray[float, 1]]]:
    if method in ("t-test", "t-test_overestim_var"):
        return _t_test(X, groups_masks, None, ireference)
    elif method == "wilcoxon":
        return _wilcoxon(X, groups_masks, None, ireference)
    else:
        empty: List[Tuple[int, ndarray[float, 1], ndarray[float, 1], ndarray[float, 1], ndarray[float, 1]]] = []
        return empty

