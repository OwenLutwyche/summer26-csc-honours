# Codon port of scanpy.tools._rank_genes_groups
# Differential expression analysis - native Codon implementation for t-test/wilcoxon

import numpy as np
from numpy import ndarray
from typing import Optional
import math
import time

def _ensure_dense(x) -> ndarray[float, 2]:
    """Convert sparse matrix to dense if needed.
    Input is untyped to accept both native ndarray and pyobj sparse matrices."""
    if hasattr(x, "toarray"):
        return x.toarray()
    return x

# codon.numpy.nan_to_num not supported, here's our native replacement
def _nan_to_num(arr: ndarray[float, 1], nan_val: float) -> ndarray[float, 1]:
    """
    Replaces NaNs and Infs in-place. 
    Runs natively at C-speed in Codon.
    """
    for i in range(arr.shape[0]):
        v = arr[i]
        if math.isnan(v):
            arr[i] = nan_val
        elif math.isinf(v):
            # Replace inf with the maximum/minimum representable 64-bit float
            arr[i] = 1.7976931348623157e+308 if v > 0.0 else -1.7976931348623157e+308
    return arr

def _norm_sf(z: float) -> float:
    """Survival function of the standard normal: P(X > z).
    Replaces sp_stats.norm.sf. Uses math.erfc which is native in Codon."""
    return 0.5 * math.erfc(z / math.sqrt(2.0))

def _rankdata(col: ndarray[float, 1]) -> ndarray[float, 1]:
    """Rank data with average tie-handling.
    Replaces sp_stats.rankdata(col) for 1D float arrays."""
    n = col.shape[0]
    # Argsort to get ordering
    order = np.argsort(col)
    ranks = np.zeros(n)
    i = 0
    while i < n:
        j = i + 1
        # Find extent of tie group
        while j < n and col[order[j]] == col[order[i]]:
            j += 1
        # Average rank for all tied elements (1-based)
        avg_rank = (i + j + 1) / 2.0  # == mean of [i+1 .. j] in 1-based
        for k in range(i, j):
            ranks[order[k]] = avg_rank
        i = j
    return ranks


def _select_top_n(scores, n_top: int):
    """Select indices of top n scores."""
    n_from = scores.shape[0]
    reference_indices = np.arange(n_from, dtype=int)
    partition = np.argpartition(scores, -n_top)[-n_top:]
    partial_indices = np.argsort(scores[partition])[::-1]
    global_indices = reference_indices[partition][partial_indices]
    return global_indices


def _mean_var(X, axis: int = 0):
    """Compute mean and variance along axis."""
    X = _ensure_dense(X)
    mean = np.mean(X, axis=axis)
    var = np.var(X, axis=axis) # avoid ddof keyword
    return mean, var


def _select_groups(adata, groups, groupby: str):
    """Get group masks for the specified groups."""
    all_groups = adata.obs[groupby].cat.categories.tolist()
    
    if groups == "all":
        groups_order = np.array(all_groups)
    else:
        groups_order = np.array(groups)
    
    n_groups = len(groups_order)
    n_cells = adata.n_obs
    
    masks = np.zeros((n_groups, n_cells), dtype=bool)
    for i, group in enumerate(groups_order):
        masks[i] = (adata.obs[groupby] == group).values
    
    return groups_order, masks


def _t_test(
    X,
    groups_masks: ndarray[bool, 2],
    groups_order,
    ireference: Optional[int],
):
    """
    Perform Welch's t-test for each gene between groups.
    Native Codon implementation for speed.
    """
    t0 = time.time()
    n_groups = int(groups_masks.shape[0])
    n_cells = int(groups_masks.shape[1])
    n_genes = int(X.shape[1])
    
    # Densify if sparse
    X = _ensure_dense(X)
    # Cast groups_masks to native bool array so ndarray boolean indexing works
    groups_masks_native: ndarray[bool, 2] = np.array(groups_masks, dtype=bool)
    
    # precompute various things
    total_sum = np.sum(X, axis=0)
    X_sq = X ** 2
    total_sum_sq = np.sum(X_sq, axis=0)
    total_n = float(n_cells)

    # Pre-allocate accumulators outside the loop
    sum_vals = np.zeros((n_groups, n_genes))
    sum_sq_vals = np.zeros((n_groups, n_genes))
    ns = np.zeros(n_groups) # number of samples for each group
    # Compute means and variances for each group
    means = np.zeros((n_groups, n_genes))
    vars_ = np.zeros((n_groups, n_genes))
    
    # Single pass accumulation (Avoids X[mask, :] copying)
    # This loop is cache-friendly for row-major matrices
    for r in range(n_cells):
        for g in range(n_groups):
            if groups_masks_native[g, r]:
                # compute sum and sum square all together
                val = X[r]
                sum_vals[g] += val
                sum_sq_vals[g] += val * val
                ns[g] += 1
    # iterate again, computing means if applicable
    for g in range(n_groups):
        if ns[g] > 1:
            means[g] = sum_vals[g] / ns[g]
            vars_[g] = np.maximum( (sum_sq_vals[g] / ns[g]) - (means[g]**2) , 0.0)

    groups_masks_time = time.time() - t0

    results: List[Tuple[int, ndarray[float, 1], ndarray[float, 1]]] = []
    
    # count the total time spent on each step in this loop
    means_time = 0.0
    welch_time = 0.0
    scipy_time = 0.0

    for group_idx in range(n_groups):
        t0 = time.time()

        if ireference is not None and group_idx == ireference:
            continue
        
        mean1 = means[group_idx]
        var1 = vars_[group_idx]
        n1 = ns[group_idx]
        
        if ireference is not None:
            iref_idx = int(ireference)
            mean2 = means[iref_idx]
            var2 = vars_[iref_idx]
            n2 = ns[iref_idx]
        else:
            # Compare to rest of the dataset
            n2 = total_n - n1
            mean2 = (total_sum - sum_vals[group_idx]) / n2
            # Variance_rest = E[X^2]_rest - (E[X]_rest)^2
            var2 = ((total_sum_sq - sum_sq_vals[group_idx]) / n2) - (mean2**2)
        
        means_time +=time.time() - t0
        
        t1 = time.time()
        # Welch's t-test

        # remove with np.errstate() here 
        se1 = var1 / n1
        se2 = var2 / n2
        se_total = np.sqrt(se1 + se2)
        
        scores = (mean1 - mean2) / se_total
        
        # Degrees of freedom (Welch-Satterthwaite)
        df_num = (se1 + se2) ** 2
        df_den = (se1 ** 2) / (n1 - 1) + (se2 ** 2) / (n2 - 1)
        df = df_num / df_den
        welch_time +=time.time() - t1
        
        t2 = time.time()
        # Two-tailed p-value
        # NOTE: sp_stats.t.sf is the last remaining bridge call in this function.
        # Replacing it requires a native betainc implementation.
        from python import scipy.stats as sp_stats
        pvals = 2 * sp_stats.t.sf(np.abs(scores), df)
        scipy_time +=time.time() - t2
        
        scores = _nan_to_num(scores, 0.0) # positional argument, nan is already 2nd position
        pvals = _nan_to_num(pvals, 1.0)
        
        results.append((group_idx, scores, pvals))
    
    print(f"groups masks time: {groups_masks_time}")
    print(f"means time: {means_time}")
    print(f"welch time: {welch_time}")
    print(f"scipy time: {scipy_time}")
    
    return results


def _wilcoxon(X, groups_masks: ndarray[bool, 2], groups_order, ireference: Optional[int] = None):
    """
    Perform Wilcoxon rank-sum test for each gene.
    Uses normal approximation for large samples.
    """
    n_groups = int(groups_masks.shape[0])
    n_genes = int(X.shape[1])
    
    X = _ensure_dense(X)
    groups_masks_native: ndarray[bool, 2] = np.array(groups_masks, dtype=bool)
    
    results: List[Tuple[int, ndarray[float, 1], ndarray[float, 1]]] = []
    
    for group_idx in range(n_groups):
        if ireference is not None and group_idx == ireference:
            continue
        
        mask1 = groups_masks_native[group_idx]
        if ireference is not None:
            iref_idx = int(ireference)
            mask2 = groups_masks_native[iref_idx]
        else:
            mask2 = ~mask1
        
        n1 = int(np.count_nonzero(mask1))
        n2 = int(np.count_nonzero(mask2))
        
        scores = np.zeros(n_genes)
        pvals = np.zeros(n_genes)
        
        # Rank all data and compute rank sums
        X_combined = np.vstack([X[mask1, :], X[mask2, :]])
        
        for j in range(n_genes):
            col = X_combined[:, j]
            ranks = _rankdata(col)
            
            # Rank sum for group 1
            R1 = ranks[:n1].sum()
            
            # Normal approximation
            mu = n1 * (n1 + n2 + 1) / 2
            
            # Tie correction
            unique = np.unique(col)
            counts = np.array([np.sum(col == u) for u in unique]) # split into two lines
            tie_term = np.sum(counts ** 3 - counts)
            sigma = np.sqrt(n1 * n2 * ((n1 + n2 + 1) / 12 - tie_term / (12 * (n1 + n2) * (n1 + n2 - 1))))
            
            if sigma > 0:
                z = (R1 - mu) / sigma
                scores[j] = z
                pvals[j] = 2 * _norm_sf(math.fabs(z))
            else:
                scores[j] = 0
                pvals[j] = 1
        
        results.append((group_idx, scores, pvals))
    
    return results


