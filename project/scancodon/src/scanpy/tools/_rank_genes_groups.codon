import numpy as np
from numpy import ndarray, float32
from typing import Optional, List, Tuple
import math

from math import exp, log, lgamma
from .._csr import CSRMatrix

EPS = 3.0e-14 
FPMIN = 1.0e-300 
MAX_ITER = 10000 

def _betacf(a: float, b: float, x: float) -> float:
    '''
    Continued fraction for the incomplete beta function.
    
    Uses Lentz's method to compute the continued fraction portion 
    of the regularized incomplete beta function.
    
    Parameters
    ----------
    a : float
        First beta parameter (alpha).
    b : float
        Second beta parameter (beta).
    x : float
        The integration upper limit.
        
    Returns
    -------
    float
        The evaluated continued fraction.
    '''
    qab = a + b
    qap = a + 1.0
    qam = a - 1.0

    c = 1.0
    d = 1.0 - qab * x / qap
    if abs(d) < FPMIN:
        d = FPMIN
    d = 1.0 / d
    h = d

    for m in range(1, MAX_ITER + 1):
        m2 = 2 * m
        aa = m * (b - m) * x
        aa /= (qam + m2) * (a + m2)

        d = 1.0 + aa * d
        if abs(d) < FPMIN:
            d = FPMIN

        c = 1.0 + aa / c
        if abs(c) < FPMIN:
            c = FPMIN

        d = 1.0 / d
        h *= d * c

        aa = -(a + m) * (qab + m) * x
        aa /= (a + m2) * (qap + m2)

        d = 1.0 + aa * d
        if abs(d) < FPMIN:
            d = FPMIN

        c = 1.0 + aa / c
        if abs(c) < FPMIN:
            c = FPMIN

        d = 1.0 / d
        delta = d * c
        h *= delta
        
        if abs(delta - 1.0) < EPS:
            break
    return h


def betainc(a: float, b: float, x: float) -> float:
    '''
    Compute the regularized incomplete beta function.
    
    Parameters
    ----------
    a : float
        First beta parameter (alpha), must be > 0
    b : float
        Second beta parameter (beta), must be > 0
    x : float
        Upper limit of integration
        
    Returns
    -------
    float
        The evaluated probability from the incomplete beta function.
    '''
    # clamp x to [0, 1]
    if x <= 0.0:
        return 0.0
    if x >= 1.0:
        return 1.0
    ln_beta = lgamma(a) + lgamma(b) - lgamma(a + b)
    bt = exp(
        a * log(x)
        + b * log(1.0 - x)
        - ln_beta
    )
    if x < (a + 1.0) / (a + b + 2.0):
        return bt * _betacf(a, b, x) / a
    else:
        return 1.0 - bt * _betacf(b, a, 1.0 - x) / b

def t_sf(t: ndarray[float, 1], df: ndarray[float, 1]) -> ndarray[float, 1]:
    '''
    Survival function (1 - CDF) for the Student's t-distribution.
    
    Used to calculate p-values from t-statistics.
    
    Parameters
    ----------
    t : ndarray[float, 1]
        Array of t-statistics.
    df : ndarray[float, 1]
        Array of degrees of freedom.
        
    Returns
    -------
    ndarray[float, 1]: computed p-values.
    '''
    n = t.shape[0]
    result = np.zeros(n, dtype=np.float64)
    
    for i in range(n):
        t_val = t[i]
        df_val = df[i]
        
        if df_val <= 0.0:
            result[i] = 1.0
            continue
            
        denom = df_val + (t_val**2.0)
        if denom == 0.0:
            result[i] = 1.0
            continue
        x = df_val / denom
        result[i] = 0.5 * betainc(df_val / 2.0, 0.5, x)
        
    return result


def _nan_to_num(arr: ndarray[float, 1], nan_val: float) -> ndarray[float, 1]:
    '''
    convert NaN values to numbers

    Parameters
    -------
    arr: ndarray[float, 1]
        1D array with some NaN values
    nan_val: float
        value to overwrite NaNs
    
    Returns
    -------
    ndarray[float, 1]: processed array containing no NaN values
    '''
    for i in range(arr.shape[0]):
        v = arr[i]
        if math.isnan(v):
            arr[i] = nan_val
        elif math.isinf(v):
            arr[i] = 1.7976931348623157e+308 if v > 0.0 else -1.7976931348623157e+308
    return arr

def clamp_to_zero(arr: ndarray[float, 1], clamp_at: float) -> ndarray[float, 1]:
    '''
    Clamps small values in an array to exactly 0

    Parameters
    -------
    arr: ndarray[float, 1]
        1D array
    clamp_at: float
        value to clamp small values to
    
    Returns
    -------
    ndarray[float, 1]: processed ndarray where all values < clamp_at are now 0
    '''
    for i in range(arr.shape[0]):
        v = arr[i]
        if v < clamp_at:
            arr[i] = 0.0
    return arr

def _norm_sf(z: float) -> float:
    '''
    Survival function for the standard normal distribution

    Parameters
    ----------
    z : float
        The z-score to evaluate.
        
    Returns
    -------
    float: The probability of observing a value greater than z.
    '''
    return 0.5 * math.erfc(z / math.sqrt(2.0))

def _rankdata(col: ndarray[float, 1]) -> ndarray[float, 1]:
    '''
    Assign ranks to data, averaging ranks for tied values.
    
    Mirrors scipy.stats.rankdata(..., method='average').
    
    Parameters
    ----------
    col : ndarray[float, 1]
        1D array of values to rank.
        
    Returns
    -------
    ndarray[float, 1]: Array of ranks corresponding to the input values.
    '''
    n = col.shape[0]
    order = np.argsort(col)
    ranks = np.zeros(n)
    i = 0
    while i < n:
        j = i + 1
        while j < n and col[order[j]] == col[order[i]]:
            j += 1
        avg_rank = (i + j + 1) / 2.0 
        for k in range(i, j):
            ranks[order[k]] = avg_rank
        i = j
    return ranks

def _correct_pvalues_bh(pvals: ndarray[float, 1]) -> ndarray[float, 1]:
    '''
    Apply Benjamini-Hochberg FDR correction to a 1D array of p-values.
    
    Parameters
    ----------
    pvals : ndarray[float, 1]
        Array of raw p-values.
        
    Returns
    -------
    adjusted : ndarray[float, 1]
        Array of FDR-adjusted p-values.
    '''
    n = pvals.shape[0]
    if n == 0:
        return np.zeros(0, dtype=float)

    sorted_idx = np.argsort(pvals)
    adjusted = np.zeros(n, dtype=float)
    prev = 1.0

    for i in range(n - 1, -1, -1):
        idx = sorted_idx[i]
        pval = pvals[idx]
        
        adj = pval * float(n) / float(i + 1)
        
        if adj > prev:
            adj = prev
        elif adj > 1.0:
            adj = 1.0
        
        adjusted[idx] = adj
        prev = adj

    return adjusted

def _sqrt_or_nan(arr: ndarray[float, 1]) -> ndarray[float, 1]:
    '''
    Element-wise sqrt that returns NaN for negative inputs.

    Equivalent to np.sqrt on values that may be negative, but avoids
    ever computing sqrt() of a negative number (side-steps a
    RuntimeWarning some numpy builds emit, and doesn't rely on
    np.errstate suppression).

    Parameters
    ----------
    arr : ndarray[float, 1]
        1D array, possibly containing negative values.

    Returns
    -------
    ndarray[float, 1]: sqrt(arr[i]) where arr[i] >= 0, else NaN.
    '''
    n = arr.shape[0]
    result = np.zeros(n, dtype=np.float64)
    for i in range(n):
        v = arr[i]
        result[i] = math.sqrt(v) if v >= 0.0 else math.nan
    return result

def _t_test_dense(
    X: ndarray[float, 2],
    groups_masks: ndarray[bool, 2],
    groups_order,
    ireference: Optional[int],
    method: str,
    input_is_float32: bool = False,
):
    n_groups = int(groups_masks.shape[0])
    n_cells = int(groups_masks.shape[1])
    n_genes = int(X.shape[1])
    
    groups_masks_native: ndarray[bool, 2] = np.array(groups_masks, dtype=bool)
    
    total_n = float(n_cells)

    sum_vals = np.zeros((n_groups, n_genes))
    sum_sq_vals = np.zeros((n_groups, n_genes))
    sum_vals_rest = np.zeros((n_groups, n_genes))
    sum_sq_vals_rest = np.zeros((n_groups, n_genes))
    ns = np.zeros(n_groups) 

    # ``fast_array_utils.stats.mean_var`` in Scanpy 1.12.2 sums dense
    # float32 inputs in float64, but applies ``x ** 2`` while they are still
    # float32. This rounding is observable in rank_genes_groups results.
    X_sq = np.zeros((n_cells, n_genes))
    for r in range(n_cells):
        for i in range(n_genes):
            value = X[r, i]
            if input_is_float32:
                value32: float32 = float32(value)
                X_sq[r, i] = float(value32 * value32)
            else:
                X_sq[r, i] = value * value
    
    means = np.zeros((n_groups, n_genes))
    vars_ = np.zeros((n_groups, n_genes))
    
    for r in range(n_cells):
        for g in range(n_groups):
            if groups_masks_native[g, r]:
                val = X[r]
                sum_vals[g] += val
                sum_sq_vals[g] += X_sq[r]
                ns[g] += 1
            else:
                # Scanpy computes every rest slice directly. Total-minus-group
                # changes the floating-point reduction order.
                sum_vals_rest[g] += X[r]
                sum_sq_vals_rest[g] += X_sq[r]
                
    for g in range(n_groups):
        if ns[g] > 1:
            means[g] = sum_vals[g] / ns[g]
            # Deliberately retain negative variances. Scanpy's legacy path
            # later obtains NaN from sqrt and normalizes it to score=0, p=1.
            var_pop = (sum_sq_vals[g] / ns[g]) - (means[g]**2)
            vars_[g] = var_pop * (ns[g] / (ns[g] - 1.0))
            
        elif ns[g] == 1:
            means[g] = sum_vals[g] / ns[g]
            vars_[g] = 0.0

    results: List[Tuple[int, ndarray[float, 1], ndarray[float, 1], ndarray[float, 1], ndarray[float, 1]]] = []
    
    for group_idx in range(n_groups):
        if ireference is not None and group_idx == ireference:
            continue
        
        mean1 = means[group_idx]
        var1 = vars_[group_idx]
        n1 = ns[group_idx]
        
        if ireference is not None:
            iref_idx = int(ireference)
            mean2 = means[iref_idx]
            var2 = vars_[iref_idx]
            n2 = ns[iref_idx]
        else:
            n2 = total_n - n1
            mean2 = sum_vals_rest[group_idx] / n2
            var2_pop = (sum_sq_vals_rest[group_idx] / n2) - (mean2**2)
            var2 = var2_pop * (n2 / (n2 - 1.0)) if n2 > 1 else np.zeros(n_genes)
        
        se1 = var1 / n1
        n2_test = n1 if method == "t-test_overestim_var" else n2

        # scipy takes sqrt(var) *per group* before combining, so a negative
        # variance in either group poisons the whole test via NaN, regardless
        # of the other group's magnitude. Summing se1+se2 first and clamping
        # only the total (the old code) lets a healthy group mask a negative
        # one instead of propagating NaN like scipy does.
        std1 = _sqrt_or_nan(var1)
        std2 = _sqrt_or_nan(var2)
        se1 = (std1 ** 2) / n1
        se2 = (std2 ** 2) / n2_test
        se_total = np.sqrt(se1 + se2)  # no floor here — let NaN propagate freely

        scores = (mean1 - mean2) / se_total
        
        df_num = (se1 + se2) ** 2
        df_den = np.zeros(n_genes, dtype=float)
        if n1 > 1:
            df_den += (se1 ** 2) / (n1 - 1)
        if n2_test > 1:
            df_den += (se2 ** 2) / (n2_test - 1)
        df = df_num / df_den

        # Matches scipy.stats._unequal_var_ttest_denom. Do not apply an
        # absolute floor: Welch's degrees of freedom are scale-invariant.
        for i in range(n_genes):
            if math.isnan(df[i]):
                df[i] = 1.0
        
        pvals = 2 * t_sf(np.abs(scores), df)
        
        for i in range(n_genes):
            if math.isnan(scores[i]):
                scores[i] = 0.0
            if math.isnan(pvals[i]):
                pvals[i] = 1.0
        
        pvals_adj = _correct_pvalues_bh(pvals)
        
        lfc = np.zeros(n_genes, dtype=float)
        for i in range(n_genes):
            numerator = math.expm1(mean1[i]) + 1e-9
            denominator = math.expm1(mean2[i]) + 1e-9
            ratio = numerator / denominator
            
            if ratio <= 0:
                lfc[i] = np.nan
            else:
                lfc[i] = math.log2(ratio)
        
        results.append((group_idx, scores, pvals, pvals_adj, lfc))
        
    return results

def _wilcoxon(X: ndarray[float, 2], groups_masks: ndarray[bool, 2], groups_order, ireference: Optional[int] = None):
    """
    Perform Wilcoxon rank-sum test for each gene between groups.
    Uses a normal approximation for large samples.
    
    Parameters
    ----------
    X : ndarray[float, 2]
        Dense matrix.
    groups_masks : ndarray[bool, 2]
        Boolean masks indicating which cells belong to which groups.
    groups_order : list or array
        Ordered labels of the groups.
    ireference : Optional[int]
        Index of the reference group to compare against. If None, compare each group with every other.
        
    Returns
    -------
    results : List[Tuple]
        A list of tuples, representing compared groups. Each tuple is:
        - group_idx (int)
        - scores (ndarray[float, 1]): Z-score from normal approximation.
        - pvals (ndarray[float, 1]): Raw two-tailed p-values.
        - pvals_adj (ndarray[float, 1]): Benjamini-Hochberg adjusted p-values.
        - lfc (ndarray[float, 1]): log2 fold change.
    """
    n_groups = int(groups_masks.shape[0])
    n_genes = int(X.shape[1])
    
    groups_masks_native: ndarray[bool, 2] = np.array(groups_masks, dtype=bool)
    
    results: List[Tuple[int, ndarray[float, 1], ndarray[float, 1], ndarray[float, 1], ndarray[float, 1]]] = []
    
    for group_idx in range(n_groups):
        if ireference is not None and group_idx == ireference:
            continue
        
        mask1 = groups_masks_native[group_idx]
        if ireference is not None:
            iref_idx = int(ireference)
            mask2 = groups_masks_native[iref_idx]
        else:
            mask2 = ~mask1
        
        n1 = int(np.count_nonzero(mask1))
        n2 = int(np.count_nonzero(mask2))
        
        scores = np.zeros(n_genes)
        pvals = np.zeros(n_genes)
        lfc = np.zeros(n_genes)
        
        # Rank all data and compute rank sums
        X_combined = np.vstack([X[mask1, :], X[mask2, :]])
        
        for j in range(n_genes):
            col = X_combined[:, j]

            # compute log fold change
            mean1 = float(np.sum(col[:n1])) / float(n1) if n1 > 0 else 0.0
            mean2 = float(np.sum(col[n1:])) / float(n2) if n2 > 0 else 0.0
            lfc[j] = math.log2((mean1 + 1e-9) / (mean2 + 1e-9))

            ranks = _rankdata(col)
            
            # Rank sum for group 1
            R1 = ranks[:n1].sum()
            
            # Normal approximation
            mu = n1 * (n1 + n2 + 1) / 2
            
            # Tie correction
            unique = np.unique(col)
            counts = np.array([np.sum(col == u) for u in unique]) # split into two lines
            tie_term = np.sum(counts ** 3 - counts)
            sigma = np.sqrt(n1 * n2 * ((n1 + n2 + 1) / 12 - tie_term / (12 * (n1 + n2) * (n1 + n2 - 1))))
            
            if sigma > 0:
                z = (R1 - mu) / sigma
                scores[j] = z
                pvals[j] = 2 * _norm_sf(math.fabs(z))
            else:
                scores[j] = 0
                pvals[j] = 1

        # FDR correction
        pvals_adj = _correct_pvalues_bh(pvals)
        results.append((group_idx, scores, pvals, pvals_adj, lfc))
    
    return results

def _t_test_sparse(
    X: CSRMatrix,
    groups_masks: ndarray[bool, 2],
    ireference: Optional[int],
):
    '''
    Perform Welch's t-test for each gene between groups.
        
        Parameters
        ----------
        X : CSRMatrix
            Sparse matrix
        groups_masks : ndarray[bool, 2]
            Boolean masks indicating which cells belong to which groups.
        ireference : Optional[int]
            Index of the reference group to compare against. If None, compare each group with every other.
            
        Returns
        -------
        results : List[Tuple]
            A list of tuples, one for each group compared. Each tuple contains:
            - group_idx (int)
            - scores (ndarray[float, 1]): T-statistic for each gene.
            - pvals (ndarray[float, 1]): Raw p-values.
            - pvals_adj (ndarray[float, 1]): Benjamini-Hochberg adjusted p-values.
            - lfc (ndarray[float, 1]): log2 fold change.
    '''
    n_groups = int(groups_masks.shape[0])
    n_cells = X.shape[0]
    n_genes = X.shape[1]
    
    groups_masks_native: ndarray[bool, 2] = np.array(groups_masks, dtype=bool)
    
    ns = np.zeros(n_groups, dtype=float)
    for r in range(n_cells):
        for g in range(n_groups):
            if groups_masks_native[g, r]:
                ns[g] += 1.0

    total_n = float(n_cells)

    sum_vals = np.zeros((n_groups, n_genes), dtype=np.float64)
    sum_vals_rest = np.zeros((n_groups, n_genes), dtype=np.float64)
    nnz_group = np.zeros((n_groups, n_genes), dtype=np.float64)
    nnz_rest = np.zeros((n_groups, n_genes), dtype=np.float64)
    
    for r in range(n_cells):
        start = X.indptr[r]
        end = X.indptr[r+1]
        in_group = np.zeros(n_groups, dtype=bool)
        for g in range(n_groups):
            if groups_masks_native[g, r]:
                in_group[g] = True
                
        for ptr in range(start, end):
            c = X.indices[ptr]
            v = X.data[ptr]
            for g in range(n_groups):
                if in_group[g]:
                    sum_vals[g, c] += v
                    nnz_group[g, c] += 1.0
                else:
                    sum_vals_rest[g, c] += v
                    nnz_rest[g, c] += 1.0

    means = np.zeros((n_groups, n_genes), dtype=np.float64)
    means_rest = np.zeros((n_groups, n_genes), dtype=np.float64)    
    for g in range(n_groups):
        if ns[g] > 0.0:
            means[g] = sum_vals[g] / ns[g]
        n2 = total_n - ns[g]
        if n2 > 0.0:
            means_rest[g] = sum_vals_rest[g] / n2

    sq_diff_group = np.zeros((n_groups, n_genes), dtype=np.float64)
    sq_diff_rest = np.zeros((n_groups, n_genes), dtype=np.float64)

    for r in range(n_cells):
        start = X.indptr[r]
        end = X.indptr[r+1]
        in_group = np.zeros(n_groups, dtype=bool)
        for g in range(n_groups):
            if groups_masks_native[g, r]:
                in_group[g] = True
                
        for ptr in range(start, end):
            c = X.indices[ptr]
            v = X.data[ptr]
            for g in range(n_groups):
                if in_group[g]:
                    diff = v - means[g, c]
                    sq_diff_group[g, c] += diff * diff
                else:
                    diff = v - means_rest[g, c]
                    sq_diff_rest[g, c] += diff * diff

    vars_ = np.zeros((n_groups, n_genes), dtype=np.float64)
    vars_rest = np.zeros((n_groups, n_genes), dtype=np.float64)
    
    for g in range(n_groups):
        n2 = total_n - ns[g]
        for c in range(n_genes):
            zero_count = ns[g] - nnz_group[g, c]
            if zero_count > 0.0:
                sq_diff_group[g, c] += zero_count * (means[g, c] ** 2)
                
            zero_count_r = n2 - nnz_rest[g, c]
            if zero_count_r > 0.0:
                sq_diff_rest[g, c] += zero_count_r * (means_rest[g, c] ** 2)
                
            # --- explicitly floor variances at 0.0 to prevent floating-point noise ---
            if ns[g] > 1.0:
                vars_[g, c] = max(sq_diff_group[g, c] / (ns[g] - 1.0), 0.0)
            if n2 > 1.0:
                vars_rest[g, c] = max(sq_diff_rest[g, c] / (n2 - 1.0), 0.0)

    results: List[Tuple[int, ndarray[float, 1], ndarray[float, 1], ndarray[float, 1], ndarray[float, 1]]] = []
    
    for group_idx in range(n_groups):
        if ireference is not None and group_idx == ireference:
            continue
        
        mean1 = means[group_idx]
        var1 = vars_[group_idx]
        n1 = ns[group_idx]
        mask1 = groups_masks_native[group_idx]
        
        if ireference is not None:
            iref_idx = int(ireference)
            mean2 = means[iref_idx]
            var2 = vars_[iref_idx]
            n2 = ns[iref_idx]
            mask2 = groups_masks_native[iref_idx]
        else:
            mean2 = means_rest[group_idx]
            var2 = vars_rest[group_idx]
            n2 = total_n - n1
            mask2 = ~mask1
        
        se1 = var1 / n1 if n1 > 0.0 else np.zeros(n_genes, dtype=float)
        se2 = var2 / n2 if n2 > 0.0 else np.zeros(n_genes, dtype=float)
        se_total = np.sqrt(np.maximum(se1 + se2, 0.0))
        
        zero_var_mask = se_total < 1e-10
        safe_se_total = np.where(zero_var_mask, 1.0, se_total)

        scores = (mean1 - mean2) / safe_se_total
        
        max_se = np.maximum(np.max(se1), np.max(se2))
        k = 1.0 / np.sqrt(max_se) if max_se > 0.0 else 1.0
        
        sse1 = se1 * k
        sse2 = se2 * k
        
        df_num = (sse1 + sse2) ** 2
        df_den = np.zeros(n_genes, dtype=float)
        
        if n1 > 1.0:
            df_den += (sse1 ** 2) / (n1 - 1.0)
        if n2 > 1.0:
            df_den += (sse2 ** 2) / (n2 - 1.0)
            
        df_den = np.where(df_den < FPMIN, 1.0, df_den)        
        df = df_num / df_den
        df = np.where(df <= 0.0, 1.0, df)
        
        pvals = 2.0 * t_sf(np.abs(scores), df)
        pvals = np.clip(pvals, 0.0, 1.0)
        
        scores[zero_var_mask] = math.nan
        pvals[zero_var_mask] = math.nan
        
        # mirror scanpy's expm1-based log fold change formula
        lfc = np.zeros(n_genes, dtype=float)
        for i in range(n_genes):
            if zero_var_mask[i]:
                lfc[i] = math.nan
                continue
            num = math.expm1(mean1[i]) + 1e-9
            den = math.expm1(mean2[i]) + 1e-9
            ratio = num / den
            if ratio <= 0.0:
                lfc[i] = math.nan
            else:
                lfc[i] = math.log2(ratio)
        scores = _nan_to_num(scores, 0.0)
        pvals = _nan_to_num(pvals, 1.0)
        pvals_adj = _correct_pvalues_bh(pvals)
        results.append((group_idx, scores, pvals, pvals_adj, lfc))
    
    return results

def rank_genes_groups_dense(
    X: ndarray[float, 2],
    groups_masks: ndarray[bool, 2],
    method: str,
    ireference: Optional[int],
    input_is_float32: bool = False,
) -> List[Tuple[int, ndarray[float, 1], ndarray[float, 1], ndarray[float, 1], ndarray[float, 1]]]:
    '''
    Dispatcher for computing differential expression on dense matrices.
    
    Routes the computation to either Welch's t-test or the Wilcoxon rank-sum 
    test based on the specified statistical method.
    
    Parameters
    ----------
    X : ndarray[float, 2]
        Dense matrix.
    groups_masks : ndarray[bool, 2]
        Boolean masks indicating which cells belong to which groups.
    method : str
        The statistical method to use ("t-test", "t-test_overestim_var", or "wilcoxon").
    ireference : Optional[int]
        Index of the reference group to compare against.
        
    Returns
    -------
    results : List[Tuple]
        The differential expression results. Returns an empty list if the method string is not recognized.
    '''
    if method in ("t-test", "t-test_overestim_var"):
        return _t_test_dense(X, groups_masks, None, ireference, method, input_is_float32)
    elif method == "wilcoxon":
        return _wilcoxon(X, groups_masks, None, ireference)
    else:
        empty: List[Tuple[int, ndarray[float, 1], ndarray[float, 1], ndarray[float, 1], ndarray[float, 1]]] = []
        return empty

def rank_genes_groups_sparse(
        X: CSRMatrix,
        groups_masks: ndarray[bool, 2],
        method: Optional[str],
        ireference: Optional[int],
        ) -> List[Tuple[int, ndarray[float, 1], ndarray[float, 1], ndarray[float, 1], ndarray[float, 1]]]:
    '''
    Dispatcher for computing differential expression on sSparse matrices.
    
    Routes the computation to Welch's t-test
    
    Parameters
    ----------
    X : CSRMatrix
        Sparse matrix.
    groups_masks : ndarray[bool, 2]
        Boolean masks indicating which cells belong to which groups.
    method : str
        The statistical method to use ("t-test", "t-test_overestim_var", or "wilcoxon").
    ireference : Optional[int]
        Index of the reference group to compare against.
        
    Returns
    -------
    results : List[Tuple]
        The differential expression results. Returns an empty list if the method string is not recognized.
    '''
    if method in "t-test":
        return _t_test_sparse(X, groups_masks, ireference)
    else:
        empty: List[Tuple[int, ndarray[float, 1], ndarray[float, 1], ndarray[float, 1], ndarray[float, 1]]] = []
        return empty
