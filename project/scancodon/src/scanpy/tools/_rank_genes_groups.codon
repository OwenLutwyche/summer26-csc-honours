# Codon port of scanpy.tools._rank_genes_groups
# Differential expression analysis - native Codon implementation for t-test/wilcoxon

import numpy as np
from numpy import ndarray
from typing import Optional
import math
import time

from math import exp, log, lgamma

# parameters for incomplete beta function
EPS = 3.0e-14 # desired relative accuracy
FPMIN = 1.0e-300 # arbitrarily small number 
MAX_ITER = 200 # maximum continued-fraction iterations before giving up

def _betacf(a: float, b: float, x: float) -> float:
    """
    continued fraction representation of the incomplete beta function
    Ix(a, b) = ( (x^a(1-x)^b)/a*B(a,b) ) * betacf(a, b, x)
    """
    qab = a + b
    qap = a + 1.0
    qam = a - 1.0


    # The continued fraction has the form
    #
    # 1 / ( 1 + aa1/(1 + aa2/(1 + aa3/...)) )
    # Lent'z algorithm computes successive approximations using c d and h
    c = 1.0
    d = 1.0 - qab * x / qap
    if abs(d) < FPMIN:
        d = FPMIN
    d = 1.0 / d
    h = d

    for m in range(1, MAX_ITER + 1):
        # even coefficient: m(b-m)x / ( (a+2m-1)(a+2m) )
        m2 = 2 * m

        # even step
        aa = m * (b - m) * x
        aa /= (qam + m2) * (a + m2)

        d = 1.0 + aa * d
        if abs(d) < FPMIN:
            d = FPMIN

        c = 1.0 + aa / c
        if abs(c) < FPMIN:
            c = FPMIN

        d = 1.0 / d
        h *= d * c

        # odd coefficient: -(a+m)(a+b+m)x / ( (a+2m)(a+2m+1) )
        aa = -(a + m) * (qab + m) * x
        aa /= (a + m2) * (qap + m2)

        d = 1.0 + aa * d
        if abs(d) < FPMIN:
            d = FPMIN

        c = 1.0 + aa / c
        if abs(c) < FPMIN:
            c = FPMIN

        d = 1.0 / d
        # check how much this iteration differs from previous estimate, standard numerical approximation stuff
        delta = d * c
        h *= delta
        
        # check if convered and end
        if abs(delta - 1.0) < EPS:
            break
    return h


def betainc(a: float, b: float, x: float) -> float:
    """
    Regularized incomplete beta function I_x(a,b).
    Ix (p, q) = 1/B(p, q) * integral(t^(p-1)*(1-t)^(q-1))dt on range x, 0
    """
    if x <= 0.0:
        return 0.0
    if x >= 1.0:
        return 1.0
    # logarithmized beta equal to log(gamma(a)) + log(gamma(b)) - log(gamma(a+b))
    ln_beta = lgamma(a) + lgamma(b) - lgamma(a + b)
    bt = exp(
        a * log(x)
        + b * log(1.0 - x)
        - ln_beta
    )
    # Use symmetry to improve convergence.
    if x < (a + 1.0) / (a + b + 2.0):
        return bt * _betacf(a, b, x) / a
    else:
        return 1.0 - bt * _betacf(b, a, 1.0 - x) / b

def t_sf(t: ndarray[float, 1], df: ndarray[float, 1]) -> ndarray[float, 1]:
    n = t.shape[0]
    result = np.zeros(n, dtype=np.float64)
    
    for i in range(n):
        t_val = t[i]
        df_val = df[i]
        # Calculate x = df / (df + t^2)
        x = df_val / (df_val + (t_val**2.0))
        
        # Corrected call: a=df/2, b=0.5, x=the_calculated_x
        # We use 0.5 * I_x(a, b) for the tail
        result[i] = 0.5 * betainc(df_val / 2.0, 0.5, x)
        
    return result

def _ensure_dense(x) -> ndarray[float, 2]:
    """Convert sparse matrix to dense if needed.
    Input is untyped to accept both native ndarray and pyobj sparse matrices."""
    if hasattr(x, "toarray"):
        return x.toarray()
    return x

# codon.numpy.nan_to_num not supported, here's our native replacement
def _nan_to_num(arr: ndarray[float, 1], nan_val: float) -> ndarray[float, 1]:
    """
    Replaces NaNs and Infs in-place. 
    Runs natively at C-speed in Codon.
    """
    for i in range(arr.shape[0]):
        v = arr[i]
        if math.isnan(v):
            arr[i] = nan_val
        elif math.isinf(v):
            # Replace inf with the maximum/minimum representable 64-bit float
            arr[i] = 1.7976931348623157e+308 if v > 0.0 else -1.7976931348623157e+308
    return arr

def clamp_to_zero(arr: ndarray[float, 1], clamp_at: float) -> ndarray[float, 1]:
    """
    Replaces very small values with 0.0
    """
    for i in range(arr.shape[0]):
        v = arr[i]
        if v < clamp_at:
            arr[i] = 0.0
    return arr


def _norm_sf(z: float) -> float:
    """Survival function of the standard normal: P(X > z).
    Replaces sp_stats.norm.sf. Uses math.erfc which is native in Codon."""
    return 0.5 * math.erfc(z / math.sqrt(2.0))

def _rankdata(col: ndarray[float, 1]) -> ndarray[float, 1]:
    """Rank data with average tie-handling.
    Replaces sp_stats.rankdata(col) for 1D float arrays."""
    n = col.shape[0]
    # Argsort to get ordering
    order = np.argsort(col)
    ranks = np.zeros(n)
    i = 0
    while i < n:
        j = i + 1
        # Find extent of tie group
        while j < n and col[order[j]] == col[order[i]]:
            j += 1
        # Average rank for all tied elements (1-based)
        avg_rank = (i + j + 1) / 2.0  # == mean of [i+1 .. j] in 1-based
        for k in range(i, j):
            ranks[order[k]] = avg_rank
        i = j
    return ranks


def _select_top_n(scores, n_top: int):
    """Select indices of top n scores."""
    n_from = scores.shape[0]
    reference_indices = np.arange(n_from, dtype=int)
    partition = np.argpartition(scores, -n_top)[-n_top:]
    partial_indices = np.argsort(scores[partition])[::-1]
    global_indices = reference_indices[partition][partial_indices]
    return global_indices


def _mean_var(X, axis: int = 0):
    """Compute mean and variance along axis."""
    X = _ensure_dense(X)
    mean = np.mean(X, axis=axis)
    var = np.var(X, axis=axis) # avoid ddof keyword
    return mean, var


def _select_groups(adata, groups, groupby: str):
    """Get group masks for the specified groups."""
    all_groups = adata.obs[groupby].cat.categories.tolist()
    
    if groups == "all":
        groups_order = np.array(all_groups)
    else:
        groups_order = np.array(groups)
    
    n_groups = len(groups_order)
    n_cells = adata.n_obs
    
    masks = np.zeros((n_groups, n_cells), dtype=bool)
    for i, group in enumerate(groups_order):
        masks[i] = (adata.obs[groupby] == group).values
    
    return groups_order, masks


def _t_test(
    X,
    groups_masks: ndarray[bool, 2],
    groups_order,
    ireference: Optional[int],
):
    """
    Perform Welch's t-test for each gene between groups.
    Native Codon implementation for speed.
    """
    n_groups = int(groups_masks.shape[0])
    n_cells = int(groups_masks.shape[1])
    n_genes = int(X.shape[1])
    
    # Densify if sparse
    X = _ensure_dense(X)
    # Cast groups_masks to native bool array so ndarray boolean indexing works
    groups_masks_native: ndarray[bool, 2] = np.array(groups_masks, dtype=bool)
    
    # precompute various things
    total_sum = np.sum(X, axis=0)
    X_sq = X ** 2
    total_sum_sq = np.sum(X_sq, axis=0)
    total_n = float(n_cells)

    # Pre-allocate accumulators outside the loop
    sum_vals = np.zeros((n_groups, n_genes))
    sum_sq_vals = np.zeros((n_groups, n_genes))
    ns = np.zeros(n_groups) # number of samples for each group
    # Compute means and variances for each group
    means = np.zeros((n_groups, n_genes))
    vars_ = np.zeros((n_groups, n_genes))
    
    # Single pass accumulation (Avoids X[mask, :] copying)
    # This loop is cache-friendly for row-major matrices
    for r in range(n_cells):
        for g in range(n_groups):
            if groups_masks_native[g, r]:
                # compute sum and sum square all together
                val = X[r]
                sum_vals[g] += val
                sum_sq_vals[g] += val * val
                ns[g] += 1
    # iterate again, computing means if applicable
    for g in range(n_groups):
        if ns[g] > 1:
            means[g] = sum_vals[g] / ns[g]
            
            # --- apply Bessel's Correction (ddof=1) with Cancellation Protection ---
            var_pop = np.maximum((sum_sq_vals[g] / ns[g]) - (means[g]**2), 0.0)
            
            for i in range(n_genes):
                expected_sq = means[g][i] ** 2
                actual_sq = sum_sq_vals[g][i] / ns[g]
                if abs(actual_sq - expected_sq) < 1e-10 * (abs(expected_sq) + 1.0):
                    var_pop[i] = 0.0

            vars_[g] = var_pop * (ns[g] / (ns[g] - 1.0))
            
        elif ns[g] == 1:
            means[g] = sum_vals[g] / ns[g]
            vars_[g] = 0.0

    results: List[Tuple[int, ndarray[float, 1], ndarray[float, 1], ndarray[float, 1], ndarray[float, 1]]] = []
    
    for group_idx in range(n_groups):

        if ireference is not None and group_idx == ireference:
            continue
        
        mean1 = means[group_idx]
        var1 = vars_[group_idx]
        n1 = ns[group_idx]
        
        if ireference is not None:
            iref_idx = int(ireference)
            mean2 = means[iref_idx]
            var2 = vars_[iref_idx]
            n2 = ns[iref_idx]
            sum_group2 = sum_vals[iref_idx]
        else:
            # Compare to rest of the dataset
            n2 = total_n - n1
            mean2 = (total_sum - sum_vals[group_idx]) / n2
            
            var2_pop = np.maximum(((total_sum_sq - sum_sq_vals[group_idx]) / n2) - (mean2**2), 0.0)
            var2 = var2_pop * (n2 / (n2 - 1.0))
            sum_group2 = total_sum - sum_vals[group_idx]

        # --- EXACT SUM GUARD: Catch genes unexpressed in both groups ---
        dual_zero_mask = (sum_vals[group_idx] == 0.0) & (sum_group2 == 0.0)

        # Welch's t-test
        se1 = var1 / n1
        se2 = var2 / n2
        se_total = np.sqrt(np.maximum(se1 + se2, 0.0))
        
        mean_diff = mean1 - mean2
        
        # --- FLOAT32 NOISE GUARD ---
        # If both the standard error and mean difference are in the float32 noise floor,
        # the gene is constant across both groups.
        noise_mask = (se_total < 1e-5) & (np.abs(mean_diff) < 1e-4)
        
        # Prevent division by zero for noise-floor genes
        safe_se_total = np.where(noise_mask, 1.0, se_total)
        scores = mean_diff / safe_se_total
        
        # Degrees of freedom (Welch-Satterthwaite)
        df_num = (se1 + se2) ** 2
        df_den = (se1 ** 2) / (n1 - 1) + (se2 ** 2) / (n2 - 1)
        df = df_num / df_den
        
        # Two-tailed p-value
        pvals = 2 * t_sf(np.abs(scores), df)
        
        # --- Force exact zero scores and p-value = 1.0 for flatline genes ---
        scores[noise_mask] = 0.0
        pvals[noise_mask] = 1.0
        df[noise_mask] = 1.0
        
        scores = _nan_to_num(scores, 0.0)
        pvals = _nan_to_num(pvals, 1.0)
        
        pvals_adj = _correct_pvalues_bh(pvals)

        lfc = np.zeros(n_genes, dtype=float)
        for i in range(n_genes):
            
            numerator = math.expm1(mean1[i]) + 1e-9
            denominator = math.expm1(mean2[i]) + 1e-9
            ratio = numerator / denominator
            
            if ratio <= 0:
                # fallback: NaN to mirror scanpy
                lfc[i] = np.nan
            else:
                lfc[i] = math.log2(ratio)
        
        # Return all 5 arrays
        results.append((group_idx, scores, pvals, pvals_adj, lfc))
    

    
    return results


def _wilcoxon(X, groups_masks: ndarray[bool, 2], groups_order, ireference: Optional[int] = None):
    """
    Perform Wilcoxon rank-sum test for each gene.
    Uses normal approximation for large samples.
    """
    n_groups = int(groups_masks.shape[0])
    n_genes = int(X.shape[1])
    
    X = _ensure_dense(X)
    groups_masks_native: ndarray[bool, 2] = np.array(groups_masks, dtype=bool)
    
    results: List[Tuple[int, ndarray[float, 1], ndarray[float, 1], ndarray[float, 1], ndarray[float, 1]]] = []
    
    for group_idx in range(n_groups):
        if ireference is not None and group_idx == ireference:
            continue
        
        mask1 = groups_masks_native[group_idx]
        if ireference is not None:
            iref_idx = int(ireference)
            mask2 = groups_masks_native[iref_idx]
        else:
            mask2 = ~mask1
        
        n1 = int(np.count_nonzero(mask1))
        n2 = int(np.count_nonzero(mask2))
        
        scores = np.zeros(n_genes)
        pvals = np.zeros(n_genes)
        lfc = np.zeros(n_genes)
        
        # Rank all data and compute rank sums
        X_combined = np.vstack([X[mask1, :], X[mask2, :]])
        
        for j in range(n_genes):
            col = X_combined[:, j]

            # compute log fold change
            mean1 = float(np.sum(col[:n1])) / float(n1) if n1 > 0 else 0.0
            mean2 = float(np.sum(col[n1:])) / float(n2) if n2 > 0 else 0.0
            lfc[j] = math.log2((mean1 + 1e-9) / (mean2 + 1e-9))

            ranks = _rankdata(col)
            
            # Rank sum for group 1
            R1 = ranks[:n1].sum()
            
            # Normal approximation
            mu = n1 * (n1 + n2 + 1) / 2
            
            # Tie correction
            unique = np.unique(col)
            counts = np.array([np.sum(col == u) for u in unique]) # split into two lines
            tie_term = np.sum(counts ** 3 - counts)
            sigma = np.sqrt(n1 * n2 * ((n1 + n2 + 1) / 12 - tie_term / (12 * (n1 + n2) * (n1 + n2 - 1))))
            
            if sigma > 0:
                z = (R1 - mu) / sigma
                scores[j] = z
                pvals[j] = 2 * _norm_sf(math.fabs(z))
            else:
                scores[j] = 0
                pvals[j] = 1

        # FDR correction
        pvals_adj = _correct_pvalues_bh(pvals)
        results.append((group_idx, scores, pvals, pvals_adj, lfc))
    
    return results


def _correct_pvalues_bh(pvals: ndarray[float, 1]) -> ndarray[float, 1]:
    """Native Codon implementation of Benjamini-Hochberg FDR correction."""
    n = pvals.shape[0]
    if n == 0:
        return np.zeros(0, dtype=float)

    sorted_idx = np.argsort(pvals)
    adjusted = np.zeros(n, dtype=float)
    prev = 1.0

    for i in range(n - 1, -1, -1):
        idx = sorted_idx[i]
        pval = pvals[idx]
        
        # adj = p * N / rank
        adj = pval * float(n) / float(i + 1)
        
        # Enforce monotonicity and cap at 1.0
        if adj > prev:
            adj = prev
        elif adj > 1.0:
            adj = 1.0
        
        adjusted[idx] = adj
        prev = adj

    return adjusted


# --- EXPORTED DISPATCHER (The new, simple entry point) ---
def rank_genes_groups_dispatcher(
    X_raw: pyobj,
    groups_masks: ndarray[bool, 2],
    method: str,
    ireference: Optional[int],
):
    """
    Main dispatcher kernel for rank_genes_groups.
    Calls pure math kernels.
    """
    # Perform explicit conversion at the boundary
    # This invokes the conversion to native memory layout once
    X: ndarray[float, 2] = np.array(_ensure_dense(X_raw), dtype=float)

    if method in ("t-test", "t-test_overestim_var"):
        print(f"[INFO] Running t-test for rank_genes_groups, ireference: {ireference}")
        return _t_test(X, groups_masks, None, ireference)
    elif method == "wilcoxon":
        print("[INFO] Running Wilcoxon test for rank_genes_groups")
        return _wilcoxon(X, groups_masks, None, ireference)
    else:
        # Fallback for unsupported methods
        empty: List[Tuple[int, ndarray[float, 1], ndarray[float, 1], ndarray[float, 1], ndarray[float, 1]]] = []
        return empty
