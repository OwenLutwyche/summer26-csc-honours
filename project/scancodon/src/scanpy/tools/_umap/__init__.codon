# _umap folder header
# Codon port of scanpy.tools._umap and its backend at lmcinnes/umap
# takes CSRMatrix instead of AnnData since AnnData conversion happens at python layer

from typing import Optional
from numpy import ndarray

from ..._csr import CSRMatrix
from ._umap import simplicial_set_embedding
from .utils import find_ab_params


def umap(
    connectivities: CSRMatrix,
    n_components: int,
    n_epochs: int,
    alpha: float,
    min_dist: float,
    spread: float,
    gamma: float,
    negative_sample_rate: int,
    random_state: int,
    init_pos: Optional[str],
    init_coords: Optional[ndarray[float32, 2]],
) -> ndarray[float32, 2]:
    '''
    native codon umap entry point
    compute a, b params outside of simplical_set_embedding to keep with "upstream" version
    '''
    a, b = find_ab_params(min_dist, spread)
    return simplicial_set_embedding(
        graph=connectivities,
        n_components=n_components,
        initial_alpha=alpha * 2.0, # double learning rate to compensate for parallel state reads
        a=a,
        b=b,
        gamma=gamma,
        negative_sample_rate=negative_sample_rate,
        n_epochs=n_epochs,
        random_state=random_state,
        init_pos = init_pos,
        init=init_coords,
    )
