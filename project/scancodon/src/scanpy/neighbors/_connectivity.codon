# Codon port of scanpy.neighbors._connectivity

import numpy as np
from numpy import ndarray
import math
from typing import Tuple, Dict, List
from .._csr import CSRMatrix

# still needed for jaccard and umap
from python import scipy.sparse as sp_sparse

from ..tools import umap

# still needed for jaccard
from ._common import is_sparse, get_sparse_matrix_from_indices_distances


def smooth_knn_dist(
    knn_distances: ndarray[float, 2],
    k: int,
    n_iter: int = 64,
    local_connectivity: float = 1.0,
    bandwidth: float = 1.0,
) -> Tuple[ndarray[float, 1], ndarray[float, 1]]:
    """
    Native port of UMAP's smooth_knn_dist binary search.
    Computes rho (local density) and sigma (bandwidth) for each cell.
    """
    n_obs = knn_distances.shape[0]
    rho = np.zeros(n_obs, dtype=float)
    sigma = np.zeros(n_obs, dtype=float)

    # The target sum of exponential weights is log2(k)
    target = math.log2(float(k)) * bandwidth

    for i in range(n_obs):
        # 1. Compute rho_i (Distance to the local_connectivity-th nearest neighbor)
        # we must filter out 0.0 distances to account for duplicate points in the dataset
        non_zero_dists = list[float]()
        for j in range(k):
            d = knn_distances[i, j]
            if d > 0.0:
                non_zero_dists.append(d)
                
        # Interpolate rho based on local_connectivity
        if len(non_zero_dists) >= int(math.floor(local_connectivity)):
            index = int(math.floor(local_connectivity))
            interpolation = local_connectivity - float(index)
            if index > 0:
                rho[i] = non_zero_dists[index - 1]
                if interpolation > 0.0 and index < len(non_zero_dists):
                    rho[i] += interpolation * (non_zero_dists[index] - non_zero_dists[index - 1])
            else:
                rho[i] = interpolation * non_zero_dists[0]
        elif len(non_zero_dists) > 0:
            rho[i] = non_zero_dists[-1]
        else:
            rho[i] = 0.0
            
        # 2. binary search for sigma_i
        lo = 0.0
        hi = float("inf")
        mid = 1.0
        
        for _ in range(n_iter):
            psum = 0.0
            for j in range(k):
                # max(0, d_j - rho_i)
                d = knn_distances[i, j] - rho[i]
                if d > 0.0:
                    psum += math.exp(-(d / mid))
                else:
                    psum += 1.0
                    
            if abs(psum - target) < 1e-5:
                break
                
            if psum > target:
                hi = mid
                mid = (lo + hi) / 2.0
            else:
                lo = mid
                if hi == float("inf"):
                    mid *= 2.0
                else:
                    mid = (lo + hi) / 2.0
                    
        sigma[i] = mid
        
    return rho, sigma




def umap_connectivity(
    knn_indices: ndarray[int, 2],
    knn_distances: ndarray[float, 2],
    n_obs: int,
    n_neighbors: int,
    local_connectivity: float = 1.0,
    bandwidth: float = 1.0,
) -> CSRMatrix:
    """
    Native Codon implementation of UMAP's fuzzy simplicial set connectivities.
    Replaces the Python bridge to umap-learn.
    """
    k = knn_indices.shape[1]
    
    # compute rho and sigma via binary search
    rho, sigma = smooth_knn_dist(
        knn_distances, k, 64, local_connectivity, bandwidth
    )
    
    # build the directed adjacency list (LIL format)
    # using an array of dictionaries allows fast O(1) edge lookups during symmetrization
    adj = [Dict[int, float]() for _ in range(n_obs)]
    
    for i in range(n_obs):
        for idx in range(k):
            j = int(knn_indices[i, idx])
            
            # guard against padded/invalid kNN indices
            if j < 0 or j >= n_obs:
                continue
                
            d = float(knn_distances[i, idx])
            val = d - rho[i]
            
            # compute directed weight: exp(-max(0, d - rho) / sigma)
            if val <= 0.0:
                w = 1.0
            elif sigma[i] > 0.0:
                w = math.exp(-(val / sigma[i]))
            else:
                w = 0.0
                
            adj[i][j] = w
            
    # symmetrize using the probabilistic T-conorm: S = A + A^T - (A * A^T)
    for i in range(n_obs):
        for j, w_ij in adj[i].items():
            # Only process each pair once (i < j) to avoid double-counting
            if i < j:
                w_ji = adj[j].get(i, 0.0)
                sym_w = w_ij + w_ji - (w_ij * w_ji)
                adj[i][j] = sym_w
                adj[j][i] = sym_w
            elif i == j:
                # Self-loops
                adj[i][j] = w_ij + w_ij - (w_ij * w_ij)
                
    # convert LIL back to strict CSRMatrix
    data_list = list[float]()
    indices_list = list[int]()
    indptr = np.zeros(n_obs + 1, dtype=int)
    
    for i in range(n_obs):
        indptr[i] = len(data_list)
        
        # extract and sort columns for CSR compliance
        cols = list[int]()
        for col in adj[i].keys():
            cols.append(col)
        cols.sort()
        
        for j in cols:
            data_list.append(adj[i][j])
            indices_list.append(j)
            
    indptr[n_obs] = len(data_list)
    
    # build CSR
    nnz = len(data_list)
    final_data = np.zeros(nnz, dtype=float)
    final_indices = np.zeros(nnz, dtype=int)
    
    for idx in range(nnz):
        final_data[idx] = data_list[idx]
        final_indices[idx] = indices_list[idx]
        
    return CSRMatrix(final_data, final_indices, indptr, (n_obs, n_obs))


def jaccard_connectivity(knn_indices, n_obs: int):
    """Derive Jaccard connectivities between data points from kNN indices.
    
    Re-implements the weighting method from PhenoGraph exactly as scanpy does.
    
    Parameters
    ----------
    knn_indices : ndarray of shape (n_obs, k)
        Indices of k-nearest neighbors (self already excluded).
    n_obs : int
        Number of observations.
        
    Returns
    -------
    CSR sparse matrix of Jaccard connectivities.
    """
    # Build unweighted kNN adjacency matrix
    k = knn_indices.shape[1]
    ones = np.ones_like(knn_indices, dtype=np.float64)
    
    adjacency = get_sparse_matrix_from_indices_distances(knn_indices, ones, n_obs)
    
    # Compute |N(i) ∩ N(j)| using vectorized sparse operations
    i_idx = np.repeat(np.arange(n_obs), k)
    j_idx = knn_indices.ravel()
    
    rows_i = adjacency[i_idx, :]
    rows_j = adjacency[j_idx, :]
    shared = np.asarray(rows_i.multiply(rows_j).sum(axis=1)).ravel()
    
    # Jaccard index: |intersection| / |union| = shared / (2k - shared)
    jaccard_vals = shared / (2.0 * k - shared)
    
    # Build connectivity matrix, filtering out zeros
    mask = jaccard_vals != 0
    connectivities = sp_sparse.csr_matrix(
        (jaccard_vals[mask], (i_idx[mask], j_idx[mask])),
        shape=(n_obs, n_obs),
    )
    
    # Symmetrize by averaging (as default in PhenoGraph)
    connectivities = (connectivities + connectivities.T) / 2.0
    
    return connectivities


def gauss_connectivity(
    knn_indices: ndarray[int, 2],
    knn_distances: ndarray[float, 2],
    n_obs: int,
    ) -> Tuple[ndarray[float, 1], ndarray[int, 1], ndarray[int, 1]]:
    """Compute Gaussian kernel connectivities from kNN graph.
    
    Matches scanpy's gauss() function for knn=True, sparse input case.
    Uses median of squared distances as sigma^2 (Haghverdi et al. 2016).
    
    Parameters
    ----------
    knn_indices : ndarray of shape (n_obs, k)
        Indices of k-nearest neighbors (excluding self).
    knn_distances : ndarray of shape (n_obs, k)
        Distances to k-nearest neighbors (excluding self).
    n_obs : int
        Number of observations.
        
    Returns
    -------
    data : ndarray[float, 1]  — Gaussian kernel weights
    row  : ndarray[int, 1]  — source cell indices (COO row)
    col  : ndarray[int, 1]  — target cell indices (COO col)
    """
    k = int(knn_indices.shape[1])
    
    # Compute sigma^2 using median of squared kNN distances per row
    # This matches scanpy's sparse path: sigmas_sq = np.median(distances_sq, axis=1)
    distances_sq: ndarray[float, 2] = knn_distances ** 2
    sigmas_sq: ndarray[float, 1]    = np.median(distances_sq, axis=1)  # (n_obs,)
    sigmas: ndarray[float, 1]       = np.sqrt(sigmas_sq)               # (n_obs,)
    
    # Apply Gaussian kernel to sparse matrix in-place style
    # w = sqrt(2*sigma_i*sigma_j / (sigma_i^2 + sigma_j^2)) * exp(-d^2 / (sigma_i^2 + sigma_j^2))
    # We pre-allocate for the symmetrised result which may add up to n_obs*k
    # extra entries (one per asymmetric edge), so worst case 2 * n_obs * k.
    max_edges: int = 2 * n_obs * k
    data: ndarray[float, 1] = np.zeros((max_edges,),  dtype=np.float64)
    row:  ndarray[int, 1] = np.zeros((max_edges,),  dtype=np.int32)
    col:  ndarray[int, 1] = np.zeros((max_edges,),  dtype=np.int32)
    n_written: int = 0

    # build a neighbour lookup: for each cell i, which cells have i as a neighbour? Used during symmetrisation to check if edge (j->i) exists.
    # for size efficiency use a List[Set[int]] for O(1) membership tests.
    neighbor_sets: List[Set[int]] = [Set[int]() for _ in range(n_obs)]
    
    for i in range(n_obs):
        for jj in range(k):
            neighbor_sets[i].add(int(knn_indices[i, jj]))

    for i in range(n_obs):
        sigma_i:    float = float(sigmas[i])
        sigma_sq_i: float = float(sigmas_sq[i])

        for jj in range(k):
            j: int      = int(knn_indices[i, jj])
            d_sq: float = float(distances_sq[i, jj])

            sigma_j:    float = float(sigmas[j])
            sigma_sq_j: float = float(sigmas_sq[j])

            den: float = sigma_sq_i + sigma_sq_j
            if den > 0.0:
                w: float = math.sqrt(2.0 * sigma_i * sigma_j / den) * math.exp(-d_sq / den)
            else:
                w = 0.0

            data[n_written] = w
            row[n_written]  = i
            col[n_written]  = j
            n_written += 1

    # symmetrize: for edges not in both directions, copy the value
    # this matches scanpy's logic: if i not in indices[j], set w[j,i] = w[i,j]
    w = w.tolil()
    for i in range(n_obs):
        neighbors_i = set(int(knn_indices[i, jj]) for jj in range(k))
        for jj in range(k):
            j: int = int(knn_indices[i, jj])
            # If i is not already a neighbour of j, add the reverse edge.
            if i not in neighbor_sets[j]:
                data[n_written] = data[i * k + jj]  # same weight
                row[n_written]  = j
                col[n_written]  = i
                n_written += 1

    # Crop pre-allocated arrays to the number of edges actually written.
    data = data[:n_written]
    row  = row[:n_written]
    col  = col[:n_written]

    return data, row, col # to __init__.py